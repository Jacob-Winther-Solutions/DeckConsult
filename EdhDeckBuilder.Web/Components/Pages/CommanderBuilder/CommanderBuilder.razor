@page "/commander"

<PageTitle>Commander Builder — EDH Deck Builder</PageTitle>

<div class="container-fluid">

    <div style="padding: 1.5rem 1.5rem 0 1.5rem;">
        <h2 class="mb-1">Commander Builder</h2>
        <p class="text-muted mb-0">Fill in the form below and the agent will construct a tuned 99-card deck.</p>
    </div>

    @if (Keys.GetApiKey() is null)
    {
        <div style="max-width: 860px; padding: 1.5rem;">
            <div class="alert alert-info mb-0">
                Connect your Anthropic API key using the panel at the top of the page to start building.
            </div>
        </div>
    }
    else
    {
        <div style="padding: 1.5rem;">
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == "guided" ? "active" : "")"
                            @onclick='() => _activeTab = "guided"'>Guided</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == "custom" ? "active" : "")"
                            @onclick='() => _activeTab = "custom"'>Custom</button>
                </li>
            </ul>

            <div style="@(_activeTab != "guided" ? "display:none;" : "")">
                <GuidedCommanderBuilderTab @key="_guidedTabKey"
                           InitialCommander="_preCommander"
                           InitialArchetypeWeights="_preArchetypes"
                           InitialThemes="_preThemes"
                           InitialBracket="_preBracket"
                           InitialBudget="_preBudget" />
            </div>
            <div style="@(_activeTab != "custom" ? "display:none;" : "")">
                <CustomCommanderBuilderTab />
            </div>
        </div>
    }

</div>
