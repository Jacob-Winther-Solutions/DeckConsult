@if (_isBuilding)
{
    <BuildProgress AllStages="AllStages"
                   CurrentStage="@_currentStage"
                   CurrentStageDetail="@_currentStageDetail"
                   CompletedStages="_completedStages"
                   OnCancel="CancelBuild" />
}
else
{
    <div style="padding: 1.5rem;">

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <!-- ── Commander ────────────────────────────────────────────────────── -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">Choose Commander(s)</div>
        <div class="card-body">
            <CommanderPicker SelectedCommanders="_selectedCommanders"
                             OnSelectionChanged="OnCommandersChanged"
                             OnError="e => _errorMessage = e"
                             @key="_commanderResetKey" />
        </div>
    </div>

    <!-- ── Section A: Deck Description ──────────────────────────────────── -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">Deck Description <span class="text-danger small ms-1">required</span></div>
        <div class="card-body">
            <label class="form-label small fw-semibold mb-1">Describe the deck you want to build</label>
            <textarea class="form-control" rows="4" @bind="_customDescription"
                      placeholder="e.g. A fast combo deck that wins with Thassa's Oracle by milling itself out using Hermit Druid, with backup lines through Laboratory Maniac. Prioritise speed and redundancy over resilience."></textarea>
            <div class="text-muted small mt-1">Used as direct guidance for card selection — be specific about your win condition, play style, and any must-include interactions.</div>
        </div>
    </div>

    <!-- ── Section B: Role targets ──────────────────────────────────────── -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">Role Targets</div>
        <div class="card-body">
            <p class="text-muted small mb-3">Coverage targets, not physical slot counts — cards fulfilling multiple roles satisfy multiple targets simultaneously, so ideals may exceed 99. The fill engine enforces the physical 99-card constraint.</p>
            <div class="row g-2">
                @foreach (var role in FormRoles)
                {
                    var r        = role;
                    var baseline = BaselineIdeals.TryGetValue(r, out var b) ? b : 0;
                    <div class="col-6 col-md-4">
                        <label class="form-label small mb-0 fw-semibold">@RoleLabel(r)</label>
                        <div class="text-muted mb-1" style="font-size:0.7rem;">
                            @(RoleDescriptions.TryGetValue(r, out var desc) ? desc : "")
                            <span class="ms-1">(default&nbsp;@baseline)</span>
                        </div>
                        <input type="number" class="form-control form-control-sm"
                               value="@_customTemplateValues[r]"
                               min="0" max="99"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) _customTemplateValues[r] = Math.Max(0, v); }" />
                    </div>
                }
            </div>
            <div class="mt-3">
                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="() => _customTemplateValues = BuildDefaultTemplateValues()">
                    Reset to defaults
                </button>
            </div>
        </div>
    </div>

    <!-- ── Budget ────────────────────────────────────────────────────────── -->
    <BudgetPicker OnChanged="OnBudgetChanged" @key="_budgetResetKey" />

    <!-- ── Must-include cards ───────────────────────────────────────────── -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">
            Must-Include Cards
            <span class="text-muted fw-normal small ms-2">optional</span>
        </div>
        <div class="card-body">
            <label class="form-label small fw-semibold mb-1">One card name per line</label>
            <textarea class="form-control" rows="4"
                      value="@_lockedCardsText"
                      @oninput="OnLockedCardsTextChanged"
                      placeholder=@("Sol Ring\nRhystic Study\nCyclonic Rift")
                      disabled="@(_selectedCommanders.Count == 0)"></textarea>
            <div class="text-muted small mt-1">These cards are locked into the deck regardless of budget, theme, or LLM selection. Budget constraints do not apply to them.</div>
            <div class="mt-2">
                <button class="btn btn-outline-secondary btn-sm"
                        disabled="@(_selectedCommanders.Count == 0 || string.IsNullOrWhiteSpace(_lockedCardsText))"
                        @onclick="ValidateLockedCardsAsync">
                    Validate Cards
                </button>
            </div>

            @if (_lockedCardsValidated)
            {
                @if (_lockedCardErrors.Count > 0)
                {
                    <div class="alert alert-danger mt-2 mb-0 py-2">
                        <strong>Could not find these cards — fix them before building:</strong>
                        <ul class="mb-0 mt-1 small">
                            @foreach (var name in _lockedCardErrors)
                            {
                                <li>@name</li>
                            }
                        </ul>
                    </div>
                }
                @if (_lockedColorWarnings.Count > 0)
                {
                    <div class="alert alert-warning mt-2 mb-0 py-2">
                        <strong>These cards are outside the commander's color identity:</strong>
                        <ul class="mb-0 mt-1 small">
                            @foreach (var card in _lockedColorWarnings)
                            {
                                <li>@card.Name — will still be locked in if you proceed</li>
                            }
                        </ul>
                    </div>
                }
                @if (_lockedCardErrors.Count == 0 && _validatedLockedCards.Count + _lockedColorWarnings.Count > 0)
                {
                    var total = _validatedLockedCards.Count + _lockedColorWarnings.Count;
                    <div class="alert alert-success mt-2 mb-0 py-2 small">
                        @total card(s) validated and ready to lock in.
                        @if (total >= LockedCardSlotLimit)
                        {
                            <strong class="ms-1">Warning: locked cards fill all available slots — the deck builder cannot run.</strong>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- ── Build button ──────────────────────────────────────────────────── -->
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-primary btn-lg px-5"
                disabled="@(!CanBuild)"
                @onclick="StartBuildAsync">
            Build Deck
        </button>
        @if (_selectedCommanders.Count == 0)
        {
            <span class="align-self-center text-muted small">Select a commander to continue.</span>
        }
        else if (string.IsNullOrWhiteSpace(_customDescription))
        {
            <span class="align-self-center text-muted small">Add a deck description to continue.</span>
        }
        else if (!string.IsNullOrWhiteSpace(_lockedCardsText) && !_lockedCardsValidated)
        {
            <span class="align-self-center text-muted small">Validate must-include cards before building.</span>
        }
        else if (_lockedCardErrors.Count > 0)
        {
            <span class="align-self-center text-danger small">Fix card errors above before building.</span>
        }
        else if (_validatedLockedCards.Count + _lockedColorWarnings.Count >= LockedCardSlotLimit)
        {
            <span class="align-self-center text-danger small">Too many locked cards — no slots remain for the deck builder.</span>
        }
    </div>

    </div>
}
