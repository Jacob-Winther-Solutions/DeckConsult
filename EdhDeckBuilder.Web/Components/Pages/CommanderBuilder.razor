@page "/commander"
@rendermode InteractiveServer

<PageTitle>Commander Builder — EDH Deck Builder</PageTitle>

<div class="container-fluid">

    @if (_isBuilding)
    {
        <div style="max-width: 860px; padding: 1.5rem;">
        <h2 class="mb-4">Building your deck&hellip;</h2>
        <div class="list-group list-group-flush mb-4">
            @foreach (var stage in AllStages)
            {
                var isDone    = _completedStages.Contains(stage);
                var isCurrent = _currentStage == stage;
                <div class="list-group-item d-flex align-items-center gap-3 px-0 border-0">
                    @if (isDone)
                    {
                        <span class="text-success fs-5">&#10003;</span>
                    }
                    else if (isCurrent)
                    {
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Running</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted fs-5">&#9675;</span>
                    }
                    <span class="@(isDone ? "text-success" : isCurrent ? "" : "text-muted")">@stage</span>
                </div>
            }
        </div>
        <button class="btn btn-outline-secondary" @onclick="CancelBuild">Cancel</button>
        </div>
    }
    else if (_result is not null)
    {
        <div class="d-flex align-items-center gap-2 px-3 pt-4 pb-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetForm">&#8592; Build another</button>
            <button class="btn btn-outline-primary btn-sm" @onclick="() => _showExport = !_showExport">
                @(_showExport ? "Hide Decklist" : "Copy Decklist")
            </button>
            <button class="btn btn-outline-primary btn-sm" @onclick="DownloadBuildReportAsync">
                Export Build Report
            </button>
        </div>

        @if (_showExport)
        {
            <div class="mx-3 mb-3">
                <div class="card">
                    <div class="card-header d-flex align-items-center gap-2">
                        <span class="fw-semibold me-auto">Raw decklist — paste into your favorite deck site</span>
                        <button class="btn btn-sm @(_exportCopied ? "btn-success" : "btn-primary")"
                                @onclick="CopyExportTextAsync">
                            @(_exportCopied ? "Copied!" : "Copy to clipboard")
                        </button>
                    </div>
                    <div class="card-body p-2">
                        <textarea class="form-control font-monospace" rows="12" readonly
                                  style="font-size: 0.8rem; resize: vertical;">@BuildExportText()</textarea>
                    </div>
                </div>
            </div>
        }

        <DeckResults Result="_result"
                     Commanders="_selectedCommanders"
                     Bracket="_bracket"
                     MaxCardPriceUsd="ParsedMaxCardPrice"
                     TotalBudgetUsd="ParsedTotalBudget" />
    }
    else
    {
        <div style="max-width: 860px; padding: 1.5rem;">
        <h2 class="mb-1">Commander Builder</h2>
        <p class="text-muted mb-4">Fill in the form below and the agent will construct a tuned 99-card deck.</p>

        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <!-- ── Section 0: API Key ────────────────────────────────────────── -->
        <ApiKeySettings OnKeyStateChanged="OnKeyStateChanged" />

        @if (Keys.GetApiKey() is null)
        {
            <div class="alert alert-info">
                Connect your Anthropic API key above to start building.
            </div>
        }
        else
        {

        <!-- ── Section 1: Commander ──────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">1 &mdash; Choose Commander(s)</div>
            <div class="card-body">

                @if (_selectedCommanders.Count < 2)
                {
                    <div class="position-relative mb-2">
                        <input class="form-control"
                               type="text"
                               placeholder="Search for a commander&hellip;"
                               value="@_commanderQuery"
                               @oninput="OnCommanderInput"
                               @onfocus="OnSearchFocus"
                               @onblur="OnSearchBlur"
                               autocomplete="off" />
                        @if (_isSearching)
                        {
                            <div class="position-absolute top-50 end-0 translate-middle-y pe-3">
                                <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                            </div>
                        }
                        @if (_showDropdown && _searchResults.Count > 0)
                        {
                            <div class="list-group position-absolute w-100 shadow-sm" style="z-index: 1050; top: 100%; left: 0;">
                                @foreach (var card in _searchResults)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                            @onclick="() => SelectCommander(card)">
                                        <span>@card.Name</span>
                                        <span class="d-flex gap-1">
                                            @foreach (var pip in GetColorPips(card.ColorIdentity))
                                            {
                                                <span class="badge @pip.BadgeClass" style="@pip.Style">@pip.Symbol</span>
                                            }
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_selectedCommanders.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var commander in _selectedCommanders)
                        {
                            <div class="d-flex align-items-center gap-2 border rounded px-3 py-2 bg-light">
                                <div>
                                    <div class="fw-semibold small">@commander.Name</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@commander.TypeLine</div>
                                </div>
                                <div class="d-flex gap-1">
                                    @foreach (var pip in GetColorPips(commander.ColorIdentity))
                                    {
                                        <span class="badge @pip.BadgeClass" style="@pip.Style">@pip.Symbol</span>
                                    }
                                </div>
                                <button type="button" class="btn-close btn-sm ms-1" aria-label="Remove"
                                        @onclick="() => RemoveCommander(commander)"></button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0 mt-1">Select up to two commanders for a partner pair.</p>
                }

            </div>
        </div>

        <!-- ── Section 2: Archetype ──────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">2 &mdash; Archetype <span class="text-muted fw-normal small ms-1">how it wins</span></div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var archetype in Enum.GetValues<Archetype>())
                    {
                        var profile    = ArchetypeLibrary.All[archetype];
                        var isSelected = _archetypeWeights.ContainsKey(archetype);
                        <div class="col-md-3 col-sm-6">
                            <div class="card h-100 @(isSelected ? "border-primary" : "") cursor-pointer"
                                 style="cursor:pointer;"
                                 @onclick="() => ToggleArchetype(archetype)">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="card-title mb-0">@profile.Name</h6>
                                        @if (isSelected) { <span class="text-primary">&#10003;</span> }
                                    </div>
                                    <p class="card-text small text-muted mb-0">@profile.Description</p>
                                    @if (isSelected)
                                    {
                                        <div class="d-flex gap-1 mt-2" @onclick:stopPropagation>
                                            <button class="btn btn-sm @(_archetypeWeights[archetype] >= 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SetArchetypeWeight(archetype, 1.0)">Full</button>
                                            <button class="btn btn-sm @(_archetypeWeights[archetype] < 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SetArchetypeWeight(archetype, 0.5)">Half</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <p class="text-muted small mt-2 mb-0">Leave blank to use the balanced baseline. Select multiple to blend styles.</p>
            </div>
        </div>

        <!-- ── Section 3: Theme ──────────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">3 &mdash; Theme <span class="text-muted fw-normal small ms-1">what it does &mdash; optional</span></div>
            <div class="card-body">

                <!-- Filter -->
                <div class="mb-3">
                    <input class="form-control form-control-sm" type="search" placeholder="Filter themes"
                           value="@_themeFilter"
                           @oninput="e => _themeFilter = e.Value?.ToString() ?? string.Empty" />
                </div>

                <!-- Custom themes -->
                @if (CustomThemes.Any())
                {
                    <div class="row g-2 mb-3">
                        @foreach (var (idx, wt) in CustomThemes)
                        {
                            var i = idx;
                            <div class="col-md-4 col-sm-6">
                                <div class="card h-100 border-primary">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="card-title mb-0 me-1">
                                                @wt.Profile.Name
                                                <span class="badge bg-secondary ms-1" style="font-size:0.6rem;vertical-align:middle;">custom</span>
                                            </h6>
                                            <button type="button" class="btn-close btn-sm flex-shrink-0" aria-label="Remove"
                                                    @onclick="() => _selectedThemes.RemoveAt(i)"></button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(wt.Profile.Description))
                                        {
                                            <p class="card-text small text-muted mb-2">@wt.Profile.Description</p>
                                        }
                                        <div class="d-flex gap-1 mt-1" @onclick:stopPropagation>
                                            <button class="btn btn-sm @(wt.Weight >= 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SetCustomThemeWeight(i, 1.0)">Full</button>
                                            <button class="btn btn-sm @(wt.Weight < 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SetCustomThemeWeight(i, 0.5)">Half</button>
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => OpenEditCustomForm(i)">Edit</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Preset themes grid -->
                <div class="row g-3">
                    @foreach (var theme in Enum.GetValues<Theme>())
                    {
                        var profile    = ThemeLibrary.All[theme];
                        var isSelected = IsPresetSelected(theme);
                        if (string.IsNullOrWhiteSpace(_themeFilter) ||
                            profile.Name.Contains(_themeFilter, StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="col-md-4 col-sm-6">
                                <div class="card h-100 @(isSelected ? "border-primary" : "")"
                                     style="cursor:pointer;"
                                     @onclick="() => TogglePreset(theme)">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="card-title mb-0">@profile.Name</h6>
                                            @if (isSelected) { <span class="text-primary">&#10003;</span> }
                                        </div>
                                        <p class="card-text small text-muted mb-0">@profile.Description</p>
                                        @if (isSelected)
                                        {
                                            <div class="d-flex gap-1 mt-2" @onclick:stopPropagation>
                                                <button class="btn btn-sm @(GetPresetWeight(theme) >= 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                        @onclick="() => SetPresetWeight(theme, 1.0)">Full</button>
                                                <button class="btn btn-sm @(GetPresetWeight(theme) < 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                        @onclick="() => SetPresetWeight(theme, 0.5)">Half</button>
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => OpenTuneForm(theme)">Tune</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Add custom theme button -->
                @if (!_showThemeForm)
                {
                    <div class="mt-3">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="OpenCustomForm">+ Add custom theme</button>
                    </div>
                }

                <!-- Tune / custom theme form -->
                @if (_showThemeForm)
                {
                    <div class="card mt-3">
                        <div class="card-header small fw-semibold">
                            @(_tuningPreset.HasValue
                                ? $"Tune: {ThemeLibrary.All[_tuningPreset.Value].Name}"
                                : _editingCustomIndex >= 0
                                    ? "Edit custom theme"
                                    : "Add custom theme")
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label small fw-semibold mb-1">Name</label>
                                <input class="form-control form-control-sm" @bind="_formThemeName"
                                       placeholder="Theme name" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold mb-1">
                                    Description
                                    <span class="text-muted fw-normal">(used as guidance for card selection)</span>
                                </label>
                                <input class="form-control form-control-sm" @bind="_formThemeDesc"
                                       placeholder="Describe what this theme does" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold mb-1">
                                    Role slot targets
                                    <span class="text-muted fw-normal">(baseline in parentheses)</span>
                                </label>
                                <div class="row g-2">
                                    @foreach (var formRole in FormRoles)
                                    {
                                        var r        = formRole;
                                        var baseline = BaselineIdeals.TryGetValue(r, out var b) ? b : 0;
                                        <div class="col-6 col-md-4">
                                            <label class="form-label small mb-0">
                                                @RoleLabel(r)
                                                <span class="text-muted" style="font-size:0.7rem;">(base&nbsp;@baseline)</span>
                                            </label>
                                            <input type="number" class="form-control form-control-sm"
                                                   value="@_formEffectiveValues[r]"
                                                   min="0" max="60"
                                                   @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) _formEffectiveValues[r] = Math.Max(0, v); }" />
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary btn-sm"
                                        disabled="@string.IsNullOrWhiteSpace(_formThemeName)"
                                        @onclick="ApplyThemeForm">
                                    @(_tuningPreset.HasValue ? "Apply" : _editingCustomIndex >= 0 ? "Save" : "Add")
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelThemeForm">Cancel</button>
                            </div>
                        </div>
                    </div>
                }

                <p class="text-muted small mt-3 mb-0">Leave blank for the balanced baseline. Select multiple to blend styles.</p>
            </div>
        </div>

        <!-- ── Section 4: Bracket ────────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">4 &mdash; Power Bracket</div>
            <div class="card-body">
                <div class="btn-group w-100 mb-3" role="group">
                    @foreach (var bracket in Enum.GetValues<Bracket>())
                    {
                        var profile = BracketLibrary.All[bracket];
                        <button type="button"
                                class="btn @(_bracket == bracket ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => _bracket = bracket">
                            @((int)bracket) &mdash; @profile.Name
                        </button>
                    }
                </div>
                <p class="text-muted small mb-0">@BracketLibrary.All[_bracket].Description</p>
            </div>
        </div>

        <!-- ── Section 5: Budget ────────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">5 &mdash; Budget <span class="text-muted fw-normal small ms-1">optional</span></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold mb-1">Max per card (USD)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" @bind="_maxCardPriceText"
                                   placeholder="e.g. 5.00" min="0" step="0.01" />
                        </div>
                        <div class="text-muted small mt-1">No single card may cost more than this.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold mb-1">Total deck budget (USD)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" @bind="_totalBudgetText"
                                   placeholder="e.g. 200.00" min="0" step="1" />
                        </div>
                        <div class="text-muted small mt-1">Sum of all 99 non-basic cards must stay within this.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Build button ──────────────────────────────────────────────── -->
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-lg px-5"
                    disabled="@(_selectedCommanders.Count == 0)"
                    @onclick="StartBuildAsync">
                Build Deck
            </button>
            @if (_selectedCommanders.Count == 0)
            {
                <span class="align-self-center text-muted small">Select a commander to continue.</span>
            }
        </div>

        } @* end @if (Keys.GetApiKey() is not null) *@
        </div>
    }

</div>
