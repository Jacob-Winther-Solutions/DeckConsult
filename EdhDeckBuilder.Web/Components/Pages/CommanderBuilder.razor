@page "/commander"
@rendermode InteractiveServer

<PageTitle>Commander Builder — EDH Deck Builder</PageTitle>

<div class="container-fluid">

    @if (_isBuilding)
    {
        <div style="max-width: 860px; padding: 1.5rem;">
        <h2 class="mb-4">Building your deck&hellip;</h2>
        <div class="list-group list-group-flush mb-4">
            @foreach (var stage in AllStages)
            {
                var isDone    = _completedStages.Contains(stage);
                var isCurrent = _currentStage == stage;
                <div class="list-group-item d-flex align-items-center gap-3 px-0 border-0">
                    @if (isDone)
                    {
                        <span class="text-success fs-5">&#10003;</span>
                    }
                    else if (isCurrent)
                    {
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Running</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted fs-5">&#9675;</span>
                    }
                    <span class="@(isDone ? "text-success" : isCurrent ? "" : "text-muted")">@stage</span>
                </div>
            }
        </div>
        <button class="btn btn-outline-secondary" @onclick="CancelBuild">Cancel</button>
        </div>
    }
    else if (_result is not null)
    {
        <div class="d-flex align-items-center gap-2 px-3 pt-4 pb-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetForm">&#8592; Build another</button>
        </div>
        <DeckResults Result="_result"
                     Commanders="_selectedCommanders"
                     Bracket="_bracket" />
    }
    else
    {
        <div style="max-width: 860px; padding: 1.5rem;">
        <h2 class="mb-1">Commander Builder</h2>
        <p class="text-muted mb-4">Fill in the form below and the agent will construct a tuned 99-card deck.</p>

        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger alert-dismissible">
                @_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <!-- ── Section 1: Commander ──────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">1 &mdash; Choose Commander(s)</div>
            <div class="card-body">

                @if (_selectedCommanders.Count < 2)
                {
                    <div class="position-relative mb-2">
                        <input class="form-control"
                               type="text"
                               placeholder="Search for a commander&hellip;"
                               value="@_commanderQuery"
                               @oninput="OnCommanderInput"
                               @onfocus="OnSearchFocus"
                               @onblur="OnSearchBlur"
                               autocomplete="off" />
                        @if (_isSearching)
                        {
                            <div class="position-absolute top-50 end-0 translate-middle-y pe-3">
                                <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                            </div>
                        }
                        @if (_showDropdown && _searchResults.Count > 0)
                        {
                            <div class="list-group position-absolute w-100 shadow-sm" style="z-index: 1050; top: 100%; left: 0;">
                                @foreach (var card in _searchResults)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                            @onclick="() => SelectCommander(card)">
                                        <span>@card.Name</span>
                                        <span class="d-flex gap-1">
                                            @foreach (var pip in GetColorPips(card.ColorIdentity))
                                            {
                                                <span class="badge @pip.BadgeClass" style="@pip.Style">@pip.Symbol</span>
                                            }
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_selectedCommanders.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var commander in _selectedCommanders)
                        {
                            <div class="d-flex align-items-center gap-2 border rounded px-3 py-2 bg-light">
                                <div>
                                    <div class="fw-semibold small">@commander.Name</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@commander.TypeLine</div>
                                </div>
                                <div class="d-flex gap-1">
                                    @foreach (var pip in GetColorPips(commander.ColorIdentity))
                                    {
                                        <span class="badge @pip.BadgeClass" style="@pip.Style">@pip.Symbol</span>
                                    }
                                </div>
                                <button type="button" class="btn-close btn-sm ms-1" aria-label="Remove"
                                        @onclick="() => RemoveCommander(commander)"></button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0 mt-1">Select up to two commanders for a partner pair.</p>
                }

            </div>
        </div>

        <!-- ── Section 2: Archetype ──────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">2 &mdash; Archetype <span class="text-muted fw-normal small ms-1">how it wins</span></div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var archetype in Enum.GetValues<Archetype>())
                    {
                        var profile    = ArchetypeLibrary.All[archetype];
                        var isSelected = _archetypeWeights.ContainsKey(archetype);
                        <div class="col-md-3 col-sm-6">
                            <div class="card h-100 @(isSelected ? "border-primary" : "") cursor-pointer"
                                 style="cursor:pointer;"
                                 @onclick="() => ToggleArchetype(archetype)">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="card-title mb-0">@profile.Name</h6>
                                        @if (isSelected) { <span class="text-primary">&#10003;</span> }
                                    </div>
                                    <p class="card-text small text-muted mb-0">@profile.Description</p>
                                    @if (isSelected)
                                    {
                                        <div class="d-flex gap-1 mt-2" @onclick:stopPropagation>
                                            <button class="btn btn-sm @(_archetypeWeights[archetype] >= 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SetArchetypeWeight(archetype, 1.0)">Full</button>
                                            <button class="btn btn-sm @(_archetypeWeights[archetype] < 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SetArchetypeWeight(archetype, 0.5)">Half</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <p class="text-muted small mt-2 mb-0">Leave blank to use the balanced baseline. Select multiple to blend styles.</p>
            </div>
        </div>

        <!-- ── Section 3: Theme ──────────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">3 &mdash; Theme <span class="text-muted fw-normal small ms-1">what it does &mdash; optional</span></div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var theme in Enum.GetValues<Theme>())
                    {
                        var profile    = ThemeLibrary.All[theme];
                        var isSelected = _themeWeights.ContainsKey(theme);
                        <div class="col-md-4 col-sm-6">
                            <div class="card h-100 @(isSelected ? "border-primary" : "") cursor-pointer"
                                 style="cursor:pointer;"
                                 @onclick="() => ToggleTheme(theme)">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="card-title mb-0">@profile.Name</h6>
                                        @if (isSelected) { <span class="text-primary">&#10003;</span> }
                                    </div>
                                    <p class="card-text small text-muted mb-0">@profile.Description</p>
                                    @if (isSelected)
                                    {
                                        <div class="d-flex gap-1 mt-2" @onclick:stopPropagation>
                                            <button class="btn btn-sm @(_themeWeights[theme] >= 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SetThemeWeight(theme, 1.0)">Full</button>
                                            <button class="btn btn-sm @(_themeWeights[theme] < 1.0 ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SetThemeWeight(theme, 0.5)">Half</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ── Section 4: Bracket ────────────────────────────────────────── -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">4 &mdash; Power Bracket</div>
            <div class="card-body">
                <div class="btn-group w-100 mb-3" role="group">
                    @foreach (var bracket in Enum.GetValues<Bracket>())
                    {
                        var profile = BracketLibrary.All[bracket];
                        <button type="button"
                                class="btn @(_bracket == bracket ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => _bracket = bracket">
                            @((int)bracket) &mdash; @profile.Name
                        </button>
                    }
                </div>
                <p class="text-muted small mb-0">@BracketLibrary.All[_bracket].Description</p>
            </div>
        </div>

        <!-- ── Build button ──────────────────────────────────────────────── -->
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-lg px-5"
                    disabled="@(_selectedCommanders.Count == 0)"
                    @onclick="StartBuildAsync">
                Build Deck
            </button>
            @if (_selectedCommanders.Count == 0)
            {
                <span class="align-self-center text-muted small">Select a commander to continue.</span>
            }
        </div>
        </div>
    }

</div>
