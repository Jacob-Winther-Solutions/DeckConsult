@page "/discover"

<PageTitle>Commander Discovery — EDH Deck Builder</PageTitle>

<div class="container-fluid">

    <div style="padding: 1.5rem 1.5rem 0 1.5rem;">
        <h2 class="mb-1">Commander Discovery</h2>
        <p class="text-muted mb-0">Find commanders that fit your strategy.</p>
    </div>

    <div style="padding: 1.5rem;">
        <!-- ── Tab Navigation ─────────────────────────────────────────────── -->
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "guided" ? "active" : "")"
                        @onclick="@(() => SetTab("guided"))"
                        role="tab">
                    Guided
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "custom" ? "active" : "")"
                        @onclick="@(() => SetTab("custom"))"
                        role="tab">
                    Custom
                </button>
            </li>
        </ul>

        <!-- ── Tab Content ────────────────────────────────────────────────── -->
        @if (Keys.GetApiKey() is null && _activeTab == "guided")
        {
            <div class="alert alert-info mb-0">
                Connect your Anthropic API key using the panel at the top of the page to use Guided discovery.
            </div>
        }
        else if (_activeTab == "guided")
        {
            <DiscoveryTab />
        }
        else if (_activeTab == "custom")
        {
            <CustomDiscoveryTab />
        }
    </div>

</div>
