@using EdhDeckBuilder.Agent.Authentication
@using EdhDeckBuilder.Agent.Authentication.Claude

<div class="position-relative d-flex align-items-center gap-2">
    @if (_connected)
    {
        <span class="badge bg-success py-2 px-3">&#10003; Connected (@_selectedProvider)</span>
        <select class="form-select form-select-sm"
                style="width: auto; min-width: 200px;"
                value="@_selectedModel"
                @onchange="OnModelChanged" @key="_selectedModel">
            @foreach (var (id, label) in ClaudeModels.GetSelectionModels(_selectedProvider))
            {
                <option value="@id" selected="@(_selectedModel == id)">@label</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary" @onclick="DisconnectAsync">Disconnect</button>
    }
    else
    {
        <button class="btn btn-sm @(_showForm ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => _showForm = !_showForm">
            &#128273; API Key @(_showForm ? "▲" : "▼")
        </button>

        @if (_showForm)
        {
            <div class="position-absolute end-0 bg-white border rounded shadow p-3"
                 style="top: calc(100% + 0.5rem); min-width: 420px; z-index: 1100;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold small">Connect API Key</span>
                    <button type="button" class="btn-close btn-sm" @onclick="() => _showForm = false"></button>
                </div>

                <div class="mb-3">
                    <label class="small fw-semibold d-block mb-1">Provider</label>
                    <div class="btn-group btn-group-sm w-100" role="group">
                        <input type="radio" class="btn-check" id="provider-anthropic"
                               checked="@(_selectedProvider == AiProvider.Anthropic)"
                               @onchange="OnProviderChanged" value="@AiProvider.Anthropic" />
                        <label class="btn btn-outline-secondary" for="provider-anthropic">Anthropic</label>

                        <input type="radio" class="btn-check" id="provider-openai"
                               checked="@(_selectedProvider == AiProvider.OpenAI)"
                               @onchange="OnProviderChanged" value="@AiProvider.OpenAI" />
                        <label class="btn btn-outline-secondary" for="provider-openai">OpenAI</label>

                        <input type="radio" class="btn-check" id="provider-google"
                               checked="@(_selectedProvider == AiProvider.Google)"
                               @onchange="OnProviderChanged" value="@AiProvider.Google" />
                        <label class="btn btn-outline-secondary" for="provider-google">Google AI Studio</label>
                    </div>
                </div>

                @if (_selectedProvider == AiProvider.Anthropic)
                {
                    <p class="small text-muted mb-3">
                        Builds run on your own key, billed to your account.
                        Get one at <a href="https://console.anthropic.com/settings/keys" target="_blank" rel="noopener">console.anthropic.com</a>.
                    </p>
                }
                else if (_selectedProvider == AiProvider.OpenAI)
                {
                    <p class="small text-muted mb-3">
                        Builds run on your own key, billed to your account.
                        Get one at <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener">platform.openai.com</a>.
                    </p>
                }
                else
                {
                    <p class="small text-muted mb-3">
                        Free access to Gemini (completely free, no subscription needed).
                        Get an API key at <a href="https://ai.google.dev" target="_blank" rel="noopener">ai.google.dev</a>.
                    </p>
                }

                <div class="d-flex gap-2 align-items-start flex-wrap mb-2">
                    <input type="password" class="form-control form-control-sm"
                           style="min-width: 200px; flex: 1;"
                           placeholder="@GetPlaceholder()"
                           autocomplete="off"
                           @bind="_keyInput" @bind:event="oninput" />
                    <button class="btn btn-primary btn-sm"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_keyInput))"
                            @onclick="ConnectAsync">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                        Connect
                    </button>
                    <button class="btn btn-outline-secondary btn-sm"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_keyInput))"
                            @onclick="TestAsync">
                        Test
                    </button>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="remember-key" @bind="_remember" />
                    <label class="form-check-label small" for="remember-key">Remember for 30 days (encrypted cookie)</label>
                </div>
                @if (_message is { } msg)
                {
                    <p class="small @(_error ? "text-danger" : "text-success") mb-0">@msg</p>
                }
            </div>
        }
    }
</div>
