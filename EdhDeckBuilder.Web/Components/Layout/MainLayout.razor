@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <CardDataStatus />
            <ApiKeySettings />
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="app-footer px-4">
            <p class="mb-1">
                API keys and results are stored only in your browser — nothing is sent to our servers.
            </p>
            <p class="mb-1">
                Card data: <a href="https://scryfall.com" target="_blank" rel="noopener">Scryfall</a> (CC BY 4.0)
                &nbsp;&middot;&nbsp;
                Recommendations: <a href="https://edhrec.com" target="_blank" rel="noopener">EDHREC</a>
                &nbsp;&middot;&nbsp;
                Combos: <a href="https://commanderspellbook.com" target="_blank" rel="noopener">Commander Spellbook</a>
            </p>
            <p class="mb-0">
                Unofficial fan tool. Not affiliated with or endorsed by Wizards of the Coast.
                Card names and imagery are property of Wizards of the Coast.
            </p>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
