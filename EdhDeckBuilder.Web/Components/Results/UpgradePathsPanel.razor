@if (_isLoadingUpgrades)
{
    <div class="card mx-3 mb-3">
        <div class="card-body text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
            <span class="text-muted">@(_upgradeCurrentStage ?? "Loading upgrade suggestions…")</span>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelUpgrades">Cancel</button>
        </div>
    </div>
}
else if (_upgradeError is not null)
{
    <div class="alert alert-danger mx-3 mb-3">
        <strong>Upgrade suggestions failed:</strong> @_upgradeError
    </div>
    <div class="card mx-3 mb-3">
        <div class="card-body">
            <label class="form-label small fw-semibold mb-1">Max price per card (USD)</label>
            <div class="d-flex gap-2 align-items-center">
                <div class="input-group" style="max-width: 180px;">
                    <span class="input-group-text">$</span>
                    <input type="number" class="form-control" min="0" step="0.5"
                           placeholder="no limit"
                           @bind="_maxUpgradePriceUsd" @bind:event="oninput" />
                </div>
                <button class="btn btn-outline-primary btn-sm"
                        disabled="@(!CanRun)"
                        @onclick="RunAsync">Retry</button>
            </div>
            @ExtraControls
        </div>
    </div>
}
else if (!_started)
{
    <div class="card mx-3 mb-3">
        <div class="card-header fw-semibold">Get Upgrade Suggestions</div>
        <div class="card-body">
            <label class="form-label small fw-semibold mb-1">What isn't working? (optional)</label>
            <textarea class="form-control mb-3" rows="2"
                      @bind="_userFeedback"
                      placeholder="e.g. I always struggle to recover from a board wipe, and I can never close out games."></textarea>
            <label class="form-label small fw-semibold mb-1">Max price per card (USD)</label>
            <div class="d-flex gap-2 align-items-center">
                <div class="input-group" style="max-width: 180px;">
                    <span class="input-group-text">$</span>
                    <input type="number" class="form-control" min="0" step="0.5"
                           placeholder="no limit"
                           @bind="_maxUpgradePriceUsd" @bind:event="oninput" />
                </div>
                <button class="btn btn-primary"
                        disabled="@(!CanRun)"
                        @onclick="RunAsync">
                    Get Upgrade Suggestions
                </button>
            </div>
            <div class="text-muted small mt-2">
                Suggestions are drawn from the EDHREC pool for your commander and prioritize your biggest coverage gaps. Leave the budget empty to consider all cards regardless of price.
            </div>
            @ExtraControls
        </div>
    </div>
}
else if (_upgradeResult is not null && _upgradeResult.RoleUpgrades.Count == 0)
{
    <div class="alert alert-info mx-3 mb-3">
        No upgrade suggestions found — your deck has no significant coverage gaps, or no EDHREC candidates were available within the current budget.
    </div>
    <div class="card mx-3 mb-3">
        <div class="card-body">
            <label class="form-label small fw-semibold mb-1">What isn't working? (optional)</label>
            <textarea class="form-control mb-3" rows="2"
                      @bind="_userFeedback"
                      placeholder="e.g. I always struggle to recover from a board wipe, and I can never close out games."></textarea>
            <label class="form-label small fw-semibold mb-1">Max price per card (USD)</label>
            <div class="d-flex gap-2 align-items-center">
                <div class="input-group" style="max-width: 180px;">
                    <span class="input-group-text">$</span>
                    <input type="number" class="form-control" min="0" step="0.5"
                           placeholder="no limit"
                           @bind="_maxUpgradePriceUsd" @bind:event="oninput" />
                </div>
                <button class="btn btn-outline-primary btn-sm"
                        disabled="@(!CanRun)"
                        @onclick="RunAsync">Try Again</button>
            </div>
            @ExtraControls
        </div>
    </div>
}
else
{
    <div class="card mx-3 mb-4">
        <div class="card-body">
            <label class="form-label small fw-semibold mb-1">What isn't working? (optional)</label>
            <textarea class="form-control mb-3" rows="2"
                      @bind="_userFeedback"
                      placeholder="e.g. I always struggle to recover from a board wipe, and I can never close out games."></textarea>
            <label class="form-label small fw-semibold mb-1">Max price per card (USD)</label>
            <div class="d-flex gap-2 align-items-center">
                <div class="input-group" style="max-width: 180px;">
                    <span class="input-group-text">$</span>
                    <input type="number" class="form-control" min="0" step="0.5"
                           placeholder="no limit"
                           @bind="_maxUpgradePriceUsd" @bind:event="oninput" />
                </div>
                <button class="btn btn-outline-secondary btn-sm"
                        disabled="@(!CanRun)"
                        @onclick="RunAsync">Refresh</button>
            </div>
            @ExtraControls
        </div>
    </div>
    @foreach (var roleUpgrade in _upgradeResult!.RoleUpgrades)
    {
        <div class="card mb-4 mx-3">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <span class="me-auto">
                    @CardRoleDisplay.RoleName(roleUpgrade.Gap.Role)
                    <span class="text-muted fw-normal small ms-2">
                        actual @roleUpgrade.Gap.ActualCoverage.ToString("0.#") / ideal @roleUpgrade.Gap.IdealTarget
                    </span>
                </span>
                <span class="badge bg-warning text-dark">@roleUpgrade.Gap.Shortfall.ToString("0.#") short</span>
            </div>
            <div class="list-group list-group-flush">
                @for (int i = 0; i < roleUpgrade.Suggestions.Count; i++)
                {
                    var s    = roleUpgrade.Suggestions[i];
                    var rank = i + 1;
                    <div class="list-group-item py-3">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge bg-secondary" style="font-size: 0.7rem;">Option @rank</span>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="badge bg-success">+ Add</span>
                            <span class="fw-semibold">@s.AddCard.Name</span>
                            @if (s.AddCard.ManaValue > 0)
                            {
                                <span class="badge bg-light text-dark border" style="font-size: 0.7rem;" title="Mana value">
                                    @s.AddCard.ManaValue.ToString("0.#")
                                </span>
                            }
                            @if (s.AddCard.PriceUsd.HasValue)
                            {
                                <span class="badge bg-light text-dark border" style="font-size: 0.7rem;" title="Price">
                                    $@s.AddCard.PriceUsd.Value.ToString("F2")
                                </span>
                            }
                            <span class="text-muted small">@s.AddCard.TypeLine</span>
                        </div>
                        <p class="text-muted small mb-2 ms-1">@s.AddRationale</p>
                        @if (s.CutCard is not null)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span class="badge bg-danger">− Cut</span>
                                <span class="fw-semibold">@s.CutCard.Name</span>
                                @if (s.CutCard.ManaValue > 0)
                                {
                                    <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">
                                        @s.CutCard.ManaValue.ToString("0.#")
                                    </span>
                                }
                                @if (s.CutCard.PriceUsd.HasValue)
                                {
                                    <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">
                                        $@s.CutCard.PriceUsd.Value.ToString("F2")
                                    </span>
                                }
                                <span class="text-muted small">@s.CutCard.TypeLine</span>
                            </div>
                            @if (!string.IsNullOrEmpty(s.CutRationale))
                            {
                                <p class="text-muted small mb-0 ms-1">@s.CutRationale</p>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }
}
