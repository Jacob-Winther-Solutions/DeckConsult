<div class="py-4" style="max-width: 1000px; margin: 0 auto;">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <div class="d-flex flex-wrap align-items-start gap-3 px-3 mb-4">
        <div class="flex-grow-1">
            <h3 class="mb-0">@string.Join(" + ", Commanders.Select(c => c.Name))</h3>
            <div class="text-muted small">@string.Join(" / ", Commanders.Select(c => c.TypeLine))</div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ColorIdentityPips Identity="CommanderColorIdentity" />
            <span class="badge bg-secondary">
                Bracket @((int)Bracket) &mdash; @BracketLibrary.All[Bracket].Name
            </span>
            <span class="badge bg-light text-dark border">
                @(Result.Deck.Count + Result.BasicLandCounts.Values.Sum()) / @(100 - Commanders.Count) cards
            </span>
            @if (Result.TotalPriceUsd > 0)
            {
                var overTotal = TotalBudgetUsd.HasValue && Result.TotalPriceUsd > TotalBudgetUsd;
                <span class="badge @(overTotal ? "bg-danger" : "bg-light text-dark border")"
                      title="@(TotalBudgetUsd.HasValue ? $"Budget: ${TotalBudgetUsd:F2}" : "Total non-basic card price")">
                    $@Result.TotalPriceUsd.ToString("F2")
                </span>
            }
        </div>
    </div>

    <!-- ── View tabs ──────────────────────────────────────────────────────── -->
    <ul class="nav nav-tabs px-3 mb-3">
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.ByRole ? "active" : "")"
                    @onclick="() => _view = DeckView.ByRole">By Role</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.ByType ? "active" : "")"
                    @onclick="() => _view = DeckView.ByType">By Type</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.AllCards ? "active" : "")"
                    @onclick="() => _view = DeckView.AllCards">All Cards</button>
        </li>
    </ul>

    @if (_view == DeckView.ByRole)
    {
        <!-- ── Coverage summary ───────────────────────────────────────────── -->
        <div class="card mb-3 mx-3">
            <div class="card-header d-flex align-items-center">
                <span class="fw-semibold me-auto">Coverage Summary</span>
                <button class="btn btn-sm btn-link text-muted py-0" @onclick="() => _showCoverage = !_showCoverage">
                    @(_showCoverage ? "Hide" : "Show")
                </button>
            </div>
            @if (_showCoverage)
            {
                <table class="table table-sm mb-0 align-middle">
                    <thead class="text-muted" style="font-size: 0.8rem;">
                        <tr>
                            <th class="ps-3 fw-normal">Role</th>
                            <th class="text-center fw-normal">Planned (min&ndash;ideal&ndash;max)</th>
                            <th class="text-center fw-normal">Actual</th>
                            <th class="pe-3 fw-normal" style="min-width: 140px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in RoleDisplayOrder)
                        {
                            if (!Result.PlannedTemplate.Targets.TryGetValue(role, out var target)) continue;
                            var actual = Result.ActualCoverage.GetValueOrDefault(role, 0.0);
                            var barPct = target.Ideal > 0
                                ? Math.Min(100.0, actual / target.Ideal * 100.0)
                                : 0.0;
                            var isOk = actual >= target.Min;
                            <tr>
                                <td class="ps-3">@RoleName(role)</td>
                                <td class="text-center text-muted" style="font-size: 0.8rem;">
                                    @target.Min&ndash;@target.Ideal&ndash;@target.Max
                                </td>
                                <td class="text-center">
                                    <span class="badge @(isOk ? "bg-success" : "bg-warning text-dark")">
                                        @actual.ToString("0.#")
                                    </span>
                                </td>
                                <td class="pe-3">
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar @(isOk ? "bg-success" : "bg-warning")"
                                             style="width: @barPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- ── Coverage warnings ──────────────────────────────────────────── -->
        @if (Result.CoverageWarnings.Count > 0)
        {
            <div class="alert alert-warning mx-3 mb-3">
                <strong>Coverage warnings</strong>
                <ul class="mb-0 mt-1 small">
                    @foreach (var warning in Result.CoverageWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <!-- ── Budget warnings ───────────────────────────────────────────── -->
        @if (Result.BudgetWarnings.Count > 0)
        {
            <div class="alert alert-danger mx-3 mb-3">
                <strong>Budget warnings</strong>
                <ul class="mb-0 mt-1 small">
                    @foreach (var warning in Result.BudgetWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <!-- ── Role buckets ───────────────────────────────────────────────── -->
        @foreach (var role in RoleDisplayOrder)
        {
            var primaryCards = Result.Deck
                .Where(c => c.Roles.Primary == role)
                .OrderBy(c => c.Rank)
                .ToList();
            var secondaryCards = Result.Deck
                .Where(c => c.Roles.Primary != role && c.Roles.Secondary.Any(s => s.Role == role))
                .OrderByDescending(c => c.Roles.Secondary.First(s => s.Role == role).Weight)
                .ThenBy(c => c.Card.Name)
                .ToList();
            if (primaryCards.Count == 0 && secondaryCards.Count == 0) continue;

            var actual    = Result.ActualCoverage.GetValueOrDefault(role, 0.0);
            var cutIds    = Result.CutSuggestions.TryGetValue(role, out var cuts)
                ? cuts.Select(c => c.Card.OracleId).ToHashSet()
                : new HashSet<Guid>();
            var collapsed = _collapsedBuckets.Contains(role);

            <div class="card mb-3 mx-3">
                <div class="card-header d-flex align-items-center gap-2"
                     style="cursor: pointer;"
                     @onclick="() => ToggleBucket(role)">
                    <span class="fw-semibold me-auto">
                        @RoleName(role)
                        <span class="badge bg-secondary ms-1 fw-normal">@primaryCards.Count</span>
                        @if (secondaryCards.Count > 0)
                        {
                            <span class="badge bg-secondary bg-opacity-50 ms-1 fw-normal"
                                  title="@secondaryCards.Count card(s) also contribute to this role">
                                +@secondaryCards.Count
                            </span>
                        }
                    </span>
                    <span class="text-muted small">@actual.ToString("0.#") coverage</span>
                    @if (cutIds.Count > 0)
                    {
                        <span class="badge bg-warning text-dark">
                            @cutIds.Count cut suggestion@(cutIds.Count > 1 ? "s" : "")
                        </span>
                    }
                    <span class="text-muted small">@(collapsed ? "&#9654;" : "&#9660;")</span>
                </div>

                @if (!collapsed)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var suggestion in primaryCards)
                        {
                            var isCut = cutIds.Contains(suggestion.Card.OracleId);
                            var isOver = IsOverBudget(suggestion.Card);
                            <div class="list-group-item @(isCut ? "list-group-item-warning" : "") py-2">
                                <div class="d-flex gap-3 align-items-start">
                                    <span class="text-muted small mt-1" style="min-width:1.8rem; text-align:right;">
                                        #@suggestion.Rank
                                    </span>
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                            <span class="fw-semibold">@suggestion.Card.Name</span>
                                            @if (suggestion.Card.ManaValue > 0)
                                            {
                                                <span class="badge bg-light text-dark border"
                                                      style="font-size: 0.7rem;"
                                                      title="Mana value">
                                                    @suggestion.Card.ManaValue.ToString("0.#")
                                                </span>
                                            }
                                            @if (suggestion.Card.PriceUsd.HasValue)
                                            {
                                                <span class="badge @(isOver ? "bg-danger" : "bg-light text-dark border")"
                                                      style="font-size: 0.7rem;"
                                                      title="@(isOver ? $"Over budget (limit: ${MaxCardPriceUsd:F2})" : "Price")">
                                                    $@suggestion.Card.PriceUsd.Value.ToString("F2")
                                                </span>
                                            }
                                            <span class="text-muted small">@suggestion.Card.TypeLine</span>
                                            @foreach (var contrib in suggestion.Roles.Secondary)
                                            {
                                                var b = SecondaryBadge(contrib);
                                                <span class="badge @b.CssClass" title="@b.Tooltip">@b.Label</span>
                                            }
                                            @if (isCut)
                                            {
                                                <span class="badge bg-warning text-dark">consider cutting</span>
                                            }
                                            @if (isOver)
                                            {
                                                <span class="badge bg-danger">over budget</span>
                                            }
                                        </div>
                                        <p class="mb-0 text-muted fst-italic" style="font-size: 0.82rem;">
                                            @suggestion.Reason
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (secondaryCards.Count > 0)
                    {
                        <div class="px-3 py-2 border-top" style="background: rgba(0,0,0,0.02);">
                            <div class="text-muted fw-semibold text-uppercase mb-2"
                                 style="font-size: 0.65rem; letter-spacing: 0.05em;">
                                Also contributes
                            </div>
                            @foreach (var suggestion in secondaryCards)
                            {
                                var contrib = suggestion.Roles.Secondary.First(s => s.Role == role);
                                var b = SecondaryBadge(contrib);
                                <div class="d-flex flex-wrap align-items-center gap-2 py-1">
                                    <span class="text-muted" style="font-size: 0.85rem;">@suggestion.Card.Name</span>
                                    @if (suggestion.Card.ManaValue > 0)
                                    {
                                        <span class="badge bg-light text-dark border"
                                              style="font-size: 0.65rem;"
                                              title="Mana value">
                                            @suggestion.Card.ManaValue.ToString("0.#")
                                        </span>
                                    }
                                    <span class="badge @PrimaryRoleBadgeClass(suggestion.Roles.Primary)"
                                          style="font-size: 0.65rem;"
                                          title="Primary role">
                                        @RoleName(suggestion.Roles.Primary)
                                    </span>
                                    <span class="badge @b.CssClass"
                                          style="font-size: 0.65rem;"
                                          title="@b.Tooltip">@b.Label</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }

        <!-- ── Basic lands ────────────────────────────────────────────────── -->
        @if (Result.BasicLandCounts.Count > 0)
        {
            <div class="card mb-3 mx-3">
                <div class="card-header d-flex align-items-center gap-2"
                     style="cursor: pointer;"
                     @onclick="() => _showBasics = !_showBasics">
                    <span class="fw-semibold me-auto">
                        Basic Lands
                        <span class="badge bg-secondary ms-1 fw-normal">
                            @Result.BasicLandCounts.Values.Sum()
                        </span>
                    </span>
                    <span class="text-muted small">@(_showBasics ? "&#9660;" : "&#9654;")</span>
                </div>
                @if (_showBasics)
                {
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-4">
                            @foreach (var (land, count) in Result.BasicLandCounts.OrderByDescending(kv => kv.Value))
                            {
                                <div class="text-center">
                                    <div class="fw-semibold fs-5">@count&times;</div>
                                    <div class="text-muted small">@land</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- ── Runner-ups ─────────────────────────────────────────────────── -->
        @if (Result.RunnerUps.Count > 0)
        {
            <div class="card mb-3 mx-3">
                <div class="card-header d-flex align-items-center gap-2"
                     style="cursor: pointer;"
                     @onclick="() => _showRunnerUps = !_showRunnerUps">
                    <span class="fw-semibold me-auto">
                        Runner-Ups
                        <span class="badge bg-secondary ms-1 fw-normal">@Result.RunnerUps.Count</span>
                    </span>
                    <span class="text-muted small">Evaluated but not selected &mdash; swap candidates</span>
                    <span class="text-muted small">@(_showRunnerUps ? "&#9660;" : "&#9654;")</span>
                </div>
                @if (_showRunnerUps)
                {
                    @foreach (var group in Result.RunnerUps.GroupBy(r => r.Section).OrderBy(g => g.Key))
                    {
                        <div class="px-3 py-2 border-top">
                            <div class="text-muted small text-uppercase fw-semibold mb-2"
                                 style="font-size: 0.7rem; letter-spacing: 0.05em;">
                                @group.Key
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var candidate in group.OrderByDescending(c => c.Inclusion).Take(12))
                                {
                                    <span class="badge bg-light text-dark border"
                                          title="@candidate.Inclusion.ToString("P0") inclusion · @candidate.Card.TypeLine">
                                        @candidate.Card.Name
                                        <span class="text-muted ms-1" style="font-size:0.7em;">
                                            @candidate.Inclusion.ToString("P0")
                                        </span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }

    @if (_view == DeckView.ByType)
    {
        <!-- ── Type buckets ───────────────────────────────────────────────── -->
        @foreach (var typeName in TypeOrder)
        {
            var cards = Result.Deck
                .Where(s => CardTypeBucket(s.Card) == typeName)
                .OrderBy(s => s.Card.Name)
                .ToList();
            if (cards.Count == 0) continue;
            var typeCollapsed = _collapsedTypeBuckets.Contains(typeName);

            <div class="card mb-3 mx-3">
                <div class="card-header d-flex align-items-center gap-2"
                     style="cursor: pointer;"
                     @onclick="() => ToggleTypeBucket(typeName)">
                    <span class="fw-semibold me-auto">
                        @typeName
                        <span class="badge bg-secondary ms-1 fw-normal">@cards.Count</span>
                    </span>
                    <span class="text-muted small">@(typeCollapsed ? "&#9654;" : "&#9660;")</span>
                </div>
                @if (!typeCollapsed)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var suggestion in cards)
                        {
                            var isOverType = IsOverBudget(suggestion.Card);
                            <div class="list-group-item py-2">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="fw-semibold me-1">@suggestion.Card.Name</span>
                                    @if (suggestion.Card.ManaValue > 0)
                                    {
                                        <span class="badge bg-light text-dark border"
                                              style="font-size: 0.7rem;"
                                              title="Mana value">
                                            @suggestion.Card.ManaValue.ToString("0.#")
                                        </span>
                                    }
                                    @if (suggestion.Card.PriceUsd.HasValue)
                                    {
                                        <span class="badge @(isOverType ? "bg-danger" : "bg-light text-dark border")"
                                              style="font-size: 0.7rem;"
                                              title="@(isOverType ? $"Over budget (limit: ${MaxCardPriceUsd:F2})" : "Price")">
                                            $@suggestion.Card.PriceUsd.Value.ToString("F2")
                                        </span>
                                    }
                                    <span class="text-muted small">@suggestion.Card.TypeLine</span>
                                    <span class="badge @PrimaryRoleBadgeClass(suggestion.Roles.Primary)"
                                          style="font-size: 0.7rem;">
                                        @RoleName(suggestion.Roles.Primary)
                                    </span>
                                    @foreach (var contrib in suggestion.Roles.Secondary)
                                    {
                                        var b = SecondaryBadge(contrib);
                                        <span class="badge @b.CssClass"
                                              style="font-size: 0.7rem;"
                                              title="@b.Tooltip">@b.Label</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- ── Basic lands ────────────────────────────────────────────────── -->
        @if (Result.BasicLandCounts.Count > 0)
        {
            <div class="card mx-3 mb-3">
                <div class="card-header small fw-semibold text-muted">Basic Lands</div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-4">
                        @foreach (var (land, count) in Result.BasicLandCounts.OrderByDescending(kv => kv.Value))
                        {
                            <div class="text-center">
                                <div class="fw-semibold fs-5">@count&times;</div>
                                <div class="text-muted small">@land</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

    @if (_view == DeckView.AllCards)
    {
        <!-- ── All cards table ────────────────────────────────────────────── -->
        <div class="card mx-3 mb-3">
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead class="text-muted" style="font-size: 0.8rem;">
                        <tr>
                            <th class="ps-3 fw-normal">Card</th>
                            <th class="fw-normal text-center" style="width: 48px;">MV</th>
                            <th class="fw-normal text-center" style="width: 64px;">Price</th>
                            <th class="fw-normal">Type</th>
                            <th class="fw-normal">Roles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var suggestion in Result.Deck.OrderBy(s => s.Card.Name))
                        {
                            var isOverAll = IsOverBudget(suggestion.Card);
                            <tr class="@(isOverAll ? "table-danger" : "")">
                                <td class="ps-3 fw-semibold">@suggestion.Card.Name</td>
                                <td class="text-center">
                                    @if (suggestion.Card.ManaValue > 0)
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">
                                            @suggestion.Card.ManaValue.ToString("0.#")
                                        </span>
                                    }
                                </td>
                                <td class="text-center small @(isOverAll ? "fw-semibold" : "text-muted")">
                                    @FormatPrice(suggestion.Card.PriceUsd)
                                </td>
                                <td class="text-muted small">@suggestion.Card.TypeLine</td>
                                <td>
                                    <span class="badge @PrimaryRoleBadgeClass(suggestion.Roles.Primary)"
                                          style="font-size: 0.7rem;">
                                        @RoleName(suggestion.Roles.Primary)
                                    </span>
                                    @foreach (var contrib in suggestion.Roles.Secondary)
                                    {
                                        var b = SecondaryBadge(contrib);
                                        <span class="badge @b.CssClass ms-1"
                                              style="font-size: 0.7rem;"
                                              title="@b.Tooltip">@b.Label</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ── Basic lands ────────────────────────────────────────────────── -->
        @if (Result.BasicLandCounts.Count > 0)
        {
            <div class="card mx-3 mb-3">
                <div class="card-header small fw-semibold text-muted">Basic Lands</div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-4">
                        @foreach (var (land, count) in Result.BasicLandCounts.OrderByDescending(kv => kv.Value))
                        {
                            <div>
                                <span class="fw-semibold">@count&times;</span>
                                <span class="text-muted small ms-1">@land</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

</div>
