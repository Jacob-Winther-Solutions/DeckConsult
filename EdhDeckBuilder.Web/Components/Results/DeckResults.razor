<div class="py-4" style="max-width: 1000px; margin: 0 auto;">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <div class="d-flex flex-wrap align-items-start gap-3 px-3 mb-4">
        <div class="flex-grow-1">
            <h3 class="mb-0">@string.Join(" + ", Commanders.Select(c => c.Name))</h3>
            <div class="text-muted small">@string.Join(" / ", Commanders.Select(c => c.TypeLine))</div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ColorIdentityPips Identity="CommanderColorIdentity" />
            <span class="badge bg-secondary">
                Bracket @((int)Bracket) &mdash; @BracketLibrary.All[Bracket].Name
            </span>
            <span class="badge bg-light text-dark border">
                @(Result.Deck.Count + Result.BasicLandCounts.Values.Sum()) / @(100 - Commanders.Count) cards
            </span>
            @if (Result.TotalPriceUsd > 0)
            {
                var nonLockedTotal = Result.Deck.Where(s => !s.IsLocked).Sum(s => s.Card.PriceUsd ?? 0m);
                var overTotal = TotalBudgetUsd.HasValue && nonLockedTotal > TotalBudgetUsd;
                var lockedCount = Result.Deck.Count(s => s.IsLocked);
                var priceTitle = TotalBudgetUsd.HasValue
                    ? (lockedCount > 0 ? $"Budget: ${TotalBudgetUsd:F2} (excl. {lockedCount} locked card(s))" : $"Budget: ${TotalBudgetUsd:F2}")
                    : (lockedCount > 0 ? $"Excl. {lockedCount} locked card(s)" : "Total non-basic card price");
                <span class="badge @(overTotal ? "bg-danger" : "bg-light text-dark border")"
                      title="@priceTitle">
                    $@nonLockedTotal.ToString("F2")
                </span>
                @if (lockedCount > 0)
                {
                    <span class="badge bg-light text-muted border"
                          style="font-size: 0.7rem;"
                          title="Full deck total including locked cards">
                        $@Result.TotalPriceUsd.ToString("F2") incl. locked
                    </span>
                }
            }
        </div>
    </div>

    <!-- ── View tabs ──────────────────────────────────────────────────────── -->
    <ul class="nav nav-tabs px-3 mb-3">
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.AllCards ? "active" : "")"
                    @onclick="() => _view = DeckView.AllCards">All Cards</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.ByType ? "active" : "")"
                    @onclick="() => _view = DeckView.ByType">By Type</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.ByRole ? "active" : "")"
                    @onclick="() => _view = DeckView.ByRole">Coverage Report</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.UpgradePaths ? "active" : "")"
                    @onclick="() => _view = DeckView.UpgradePaths">
                Upgrade Paths
                @if (_upgradeResult is not null)
                {
                    <span class="badge bg-success ms-1" style="font-size:0.65rem;">@_upgradeResult.RoleUpgrades.Sum(r => r.Suggestions.Count)</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.Combos ? "active" : "")"
                    @onclick="() => _view = DeckView.Combos">
                Combos
                @if (_comboResult is not null)
                {
                    var total = _comboResult.Combos.Included.Count + _comboResult.Combos.AlmostIncluded.Count;
                    <span class="badge bg-success ms-1" style="font-size:0.65rem;">@total</span>
                }
            </button>
        </li>
    </ul>

    @if (_view == DeckView.ByRole)
    {
        <!-- ── Coverage summary ───────────────────────────────────────────── -->
        <div class="card mb-3 mx-3">
            <div class="card-header d-flex align-items-center">
                <span class="fw-semibold me-auto">Coverage Summary</span>
                <button class="btn btn-sm btn-link text-muted py-0" @onclick="() => _showCoverage = !_showCoverage">
                    @(_showCoverage ? "Hide" : "Show")
                </button>
            </div>
            @if (_showCoverage)
            {
                <table class="table table-sm mb-0 align-middle">
                    <thead class="text-muted" style="font-size: 0.8rem;">
                        <tr>
                            <th class="ps-3 fw-normal">Role</th>
                            <th class="text-center fw-normal">Planned (min&ndash;ideal&ndash;max)</th>
                            <th class="text-center fw-normal">Actual</th>
                            <th class="pe-3 fw-normal" style="min-width: 140px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in RoleDisplayOrder)
                        {
                            if (!Result.PlannedTemplate.Targets.TryGetValue(role, out var target)) continue;
                            // For Land, add basic lands so the row reflects the full land count.
                            var actual = role == CardRole.Land
                                ? Result.ActualCoverage.GetValueOrDefault(role, 0.0) + Result.BasicLandCounts.Values.Sum()
                                : Result.ActualCoverage.GetValueOrDefault(role, 0.0);
                            var barPct = target.Ideal > 0
                                ? Math.Min(100.0, actual / target.Ideal * 100.0)
                                : 0.0;
                            var isOk = actual >= target.Min;
                            <tr>
                                <td class="ps-3">@RoleName(role)</td>
                                <td class="text-center text-muted" style="font-size: 0.8rem;">
                                    @target.Min&ndash;@target.Ideal&ndash;@target.Max
                                </td>
                                <td class="text-center">
                                    <span class="badge @(isOk ? "bg-success" : "bg-warning text-dark")">
                                        @actual.ToString("0.#")
                                    </span>
                                </td>
                                <td class="pe-3">
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar @(isOk ? "bg-success" : "bg-warning")"
                                             style="width: @barPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- ── Coverage warnings ──────────────────────────────────────────── -->
        @if (Result.CoverageWarnings.Count > 0)
        {
            <div class="alert alert-warning mx-3 mb-3">
                <strong>Coverage warnings</strong>
                <ul class="mb-0 mt-1 small">
                    @foreach (var warning in Result.CoverageWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <!-- ── Budget warnings ───────────────────────────────────────────── -->
        @if (Result.BudgetWarnings.Count > 0)
        {
            <div class="alert alert-danger mx-3 mb-3">
                <strong>Budget warnings</strong>
                <ul class="mb-0 mt-1 small">
                    @foreach (var warning in Result.BudgetWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <!-- ── Role buckets ───────────────────────────────────────────────── -->
        @foreach (var role in RoleDisplayOrder)
        {
            var primaryCards = Result.Deck
                .Where(c => c.Roles.Primary == role)
                .OrderBy(c => c.Rank)
                .ToList();
            var secondaryCards = Result.Deck
                .Where(c => c.Roles.Primary != role && c.Roles.Secondary.Any(s => s.Role == role))
                .OrderByDescending(c => c.Roles.Secondary.First(s => s.Role == role).Weight)
                .ThenBy(c => c.Card.Name)
                .ToList();
            if (primaryCards.Count == 0 && secondaryCards.Count == 0) continue;

            var actual    = Result.ActualCoverage.GetValueOrDefault(role, 0.0);
            var cutIds    = Result.CutSuggestions.TryGetValue(role, out var cuts)
                ? cuts.Select(c => c.Card.OracleId).ToHashSet()
                : new HashSet<Guid>();
            var collapsed = _collapsedBuckets.Contains(role);

            <div class="card mb-3 mx-3">
                <div class="card-header d-flex align-items-center gap-2"
                     style="cursor: pointer;"
                     @onclick="() => ToggleBucket(role)">
                    <span class="fw-semibold me-auto">
                        @RoleName(role)
                        <span class="badge bg-secondary ms-1 fw-normal">@primaryCards.Count</span>
                        @if (secondaryCards.Count > 0)
                        {
                            <span class="badge bg-secondary bg-opacity-50 ms-1 fw-normal"
                                  title="@secondaryCards.Count card(s) also contribute to this role">
                                +@secondaryCards.Count
                            </span>
                        }
                    </span>
                    <span class="text-muted small">@actual.ToString("0.#") coverage</span>
                    @if (cutIds.Count > 0)
                    {
                        <span class="badge bg-warning text-dark">
                            @cutIds.Count cut suggestion@(cutIds.Count > 1 ? "s" : "")
                        </span>
                    }
                    <span class="text-muted small">@(collapsed ? "&#9654;" : "&#9660;")</span>
                </div>

                @if (!collapsed)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var suggestion in primaryCards)
                        {
                            var isCut = cutIds.Contains(suggestion.Card.OracleId);
                            var isOver = !suggestion.IsLocked && IsOverBudget(suggestion.Card);
                            <div class="list-group-item @(isCut ? "list-group-item-warning" : "") py-2">
                                <div class="d-flex gap-3 align-items-start">
                                    <span class="text-muted small mt-1" style="min-width:1.8rem; text-align:right;">
                                        #@suggestion.Rank
                                    </span>
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                            <span class="fw-semibold">@suggestion.Card.Name</span>
                                            @if (suggestion.Card.ManaValue > 0)
                                            {
                                                <span class="badge bg-light text-dark border"
                                                      style="font-size: 0.7rem;"
                                                      title="Mana value">
                                                    @suggestion.Card.ManaValue.ToString("0.#")
                                                </span>
                                            }
                                            @if (suggestion.Card.PriceUsd.HasValue)
                                            {
                                                <span class="badge @(isOver ? "bg-danger" : "bg-light text-dark border")"
                                                      style="font-size: 0.7rem;"
                                                      title="@(isOver ? $"Over budget (limit: ${MaxCardPriceUsd:F2})" : "Price")">
                                                    $@suggestion.Card.PriceUsd.Value.ToString("F2")
                                                </span>
                                            }
                                            <span class="text-muted small">@suggestion.Card.TypeLine</span>
                                            @foreach (var contrib in suggestion.Roles.Secondary)
                                            {
                                                var b = SecondaryBadge(contrib);
                                                <span class="badge @b.CssClass" title="@b.Tooltip">@b.Label</span>
                                            }
                                                            @if (suggestion.IsLocked)
                                            {
                                                <span class="badge bg-secondary" title="Locked by user — will not be cut">&#128274; locked</span>
                                            }
                                            @if (isCut)
                                            {
                                                <span class="badge bg-warning text-dark">consider cutting</span>
                                            }
                                            @if (isOver)
                                            {
                                                <span class="badge bg-danger">over budget</span>
                                            }
                                        </div>
                                        <p class="mb-0 text-muted fst-italic" style="font-size: 0.82rem;">
                                            @suggestion.Reason
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (secondaryCards.Count > 0)
                    {
                        <div class="px-3 py-2 border-top" style="background: rgba(0,0,0,0.02);">
                            <div class="text-muted fw-semibold text-uppercase mb-2"
                                 style="font-size: 0.65rem; letter-spacing: 0.05em;">
                                Also contributes
                            </div>
                            @foreach (var suggestion in secondaryCards)
                            {
                                var contrib = suggestion.Roles.Secondary.First(s => s.Role == role);
                                var b = SecondaryBadge(contrib);
                                <div class="d-flex flex-wrap align-items-center gap-2 py-1">
                                    <span class="text-muted" style="font-size: 0.85rem;">@suggestion.Card.Name</span>
                                    @if (suggestion.Card.ManaValue > 0)
                                    {
                                        <span class="badge bg-light text-dark border"
                                              style="font-size: 0.65rem;"
                                              title="Mana value">
                                            @suggestion.Card.ManaValue.ToString("0.#")
                                        </span>
                                    }
                                    <span class="badge @PrimaryRoleBadgeClass(suggestion.Roles.Primary)"
                                          style="font-size: 0.65rem;"
                                          title="Primary role">
                                        @RoleName(suggestion.Roles.Primary)
                                    </span>
                                    <span class="badge @b.CssClass"
                                          style="font-size: 0.65rem;"
                                          title="@b.Tooltip">@b.Label</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }

        <!-- ── Basic lands ────────────────────────────────────────────────── -->
        @if (Result.BasicLandCounts.Count > 0)
        {
            <div class="card mb-3 mx-3">
                <div class="card-header d-flex align-items-center gap-2"
                     style="cursor: pointer;"
                     @onclick="() => _showBasics = !_showBasics">
                    <span class="fw-semibold me-auto">
                        Basic Lands
                        <span class="badge bg-secondary ms-1 fw-normal">
                            @Result.BasicLandCounts.Values.Sum()
                        </span>
                    </span>
                    <span class="text-muted small">@(_showBasics ? "&#9660;" : "&#9654;")</span>
                </div>
                @if (_showBasics)
                {
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-4">
                            @foreach (var (land, count) in Result.BasicLandCounts.OrderByDescending(kv => kv.Value))
                            {
                                <div class="text-center">
                                    <div class="fw-semibold fs-5">@count&times;</div>
                                    <div class="text-muted small">@land</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- ── Runner-ups ─────────────────────────────────────────────────── -->
        @if (Result.RunnerUps.Count > 0)
        {
            <div class="card mb-3 mx-3">
                <div class="card-header d-flex align-items-center gap-2"
                     style="cursor: pointer;"
                     @onclick="() => _showRunnerUps = !_showRunnerUps">
                    <span class="fw-semibold me-auto">
                        Runner-Ups
                        <span class="badge bg-secondary ms-1 fw-normal">@Result.RunnerUps.Count</span>
                    </span>
                    <span class="text-muted small">Evaluated but not selected &mdash; swap candidates</span>
                    <span class="text-muted small">@(_showRunnerUps ? "&#9660;" : "&#9654;")</span>
                </div>
                @if (_showRunnerUps)
                {
                    @foreach (var group in Result.RunnerUps.GroupBy(r => r.Section).OrderBy(g => g.Key))
                    {
                        <div class="px-3 py-2 border-top">
                            <div class="text-muted small text-uppercase fw-semibold mb-2"
                                 style="font-size: 0.7rem; letter-spacing: 0.05em;">
                                @group.Key
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var candidate in group.OrderByDescending(c => c.Inclusion).Take(12))
                                {
                                    <span class="badge bg-light text-dark border"
                                          title="@candidate.Inclusion.ToString("P0") inclusion · @candidate.Card.TypeLine">
                                        @candidate.Card.Name
                                        <span class="text-muted ms-1" style="font-size:0.7em;">
                                            @candidate.Inclusion.ToString("P0")
                                        </span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }

    @if (_view == DeckView.ByType)
    {
        <!-- ── Type buckets ───────────────────────────────────────────────── -->
        @foreach (var typeName in TypeOrder)
        {
            var cards = Result.Deck
                .Where(s => CardTypeBucket(s.Card) == typeName)
                .OrderBy(s => s.Card.Name)
                .ToList();
            if (cards.Count == 0) continue;
            var typeCollapsed = _collapsedTypeBuckets.Contains(typeName);

            <div class="card mb-3 mx-3">
                <div class="card-header d-flex align-items-center gap-2"
                     style="cursor: pointer;"
                     @onclick="() => ToggleTypeBucket(typeName)">
                    <span class="fw-semibold me-auto">
                        @typeName
                        <span class="badge bg-secondary ms-1 fw-normal">@cards.Count</span>
                    </span>
                    <span class="text-muted small">@(typeCollapsed ? "&#9654;" : "&#9660;")</span>
                </div>
                @if (!typeCollapsed)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var suggestion in cards)
                        {
                            var isOverType = !suggestion.IsLocked && IsOverBudget(suggestion.Card);
                            <div class="list-group-item py-2">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="fw-semibold me-1">@suggestion.Card.Name</span>
                                    @if (suggestion.IsLocked)
                                    {
                                        <span class="badge bg-secondary" title="Locked by user — will not be cut">&#128274; locked</span>
                                    }
                                    @if (suggestion.Card.ManaValue > 0)
                                    {
                                        <span class="badge bg-light text-dark border"
                                              style="font-size: 0.7rem;"
                                              title="Mana value">
                                            @suggestion.Card.ManaValue.ToString("0.#")
                                        </span>
                                    }
                                    @if (suggestion.Card.PriceUsd.HasValue)
                                    {
                                        <span class="badge @(isOverType ? "bg-danger" : "bg-light text-dark border")"
                                              style="font-size: 0.7rem;"
                                              title="@(isOverType ? $"Over budget (limit: ${MaxCardPriceUsd:F2})" : "Price")">
                                            $@suggestion.Card.PriceUsd.Value.ToString("F2")
                                        </span>
                                    }
                                    <span class="text-muted small">@suggestion.Card.TypeLine</span>
                                    <span class="badge @PrimaryRoleBadgeClass(suggestion.Roles.Primary)"
                                          style="font-size: 0.7rem;">
                                        @RoleName(suggestion.Roles.Primary)
                                    </span>
                                    @foreach (var contrib in suggestion.Roles.Secondary)
                                    {
                                        var b = SecondaryBadge(contrib);
                                        <span class="badge @b.CssClass"
                                              style="font-size: 0.7rem;"
                                              title="@b.Tooltip">@b.Label</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- ── Basic lands ────────────────────────────────────────────────── -->
        @if (Result.BasicLandCounts.Count > 0)
        {
            <div class="card mx-3 mb-3">
                <div class="card-header small fw-semibold text-muted">Basic Lands</div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-4">
                        @foreach (var (land, count) in Result.BasicLandCounts.OrderByDescending(kv => kv.Value))
                        {
                            <div class="text-center">
                                <div class="fw-semibold fs-5">@count&times;</div>
                                <div class="text-muted small">@land</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

    @if (_view == DeckView.AllCards)
    {
        <!-- ── All cards table ────────────────────────────────────────────── -->
        <div class="card mx-3 mb-3">
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead class="text-muted" style="font-size: 0.8rem;">
                        <tr>
                            <th class="ps-3 fw-normal">Card</th>
                            <th class="fw-normal text-center" style="width: 48px;">MV</th>
                            <th class="fw-normal text-center" style="width: 64px;">Price</th>
                            <th class="fw-normal">Type</th>
                            <th class="fw-normal">Roles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var suggestion in Result.Deck.OrderBy(s => s.Card.Name))
                        {
                            var isOverAll = !suggestion.IsLocked && IsOverBudget(suggestion.Card);
                            <tr class="@(isOverAll ? "table-danger" : "")">
                                <td class="ps-3 fw-semibold">
                                    @suggestion.Card.Name
                                    @if (suggestion.IsLocked)
                                    {
                                        <span class="badge bg-secondary ms-1" style="font-size:0.65rem;" title="Locked by user — will not be cut">&#128274; locked</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (suggestion.Card.ManaValue > 0)
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">
                                            @suggestion.Card.ManaValue.ToString("0.#")
                                        </span>
                                    }
                                </td>
                                <td class="text-center small @(isOverAll ? "fw-semibold" : "text-muted")">
                                    @FormatPrice(suggestion.Card.PriceUsd)
                                </td>
                                <td class="text-muted small">@suggestion.Card.TypeLine</td>
                                <td>
                                    <span class="badge @PrimaryRoleBadgeClass(suggestion.Roles.Primary)"
                                          style="font-size: 0.7rem;">
                                        @RoleName(suggestion.Roles.Primary)
                                    </span>
                                    @foreach (var contrib in suggestion.Roles.Secondary)
                                    {
                                        var b = SecondaryBadge(contrib);
                                        <span class="badge @b.CssClass ms-1"
                                              style="font-size: 0.7rem;"
                                              title="@b.Tooltip">@b.Label</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ── Basic lands ────────────────────────────────────────────────── -->
        @if (Result.BasicLandCounts.Count > 0)
        {
            <div class="card mx-3 mb-3">
                <div class="card-header small fw-semibold text-muted">Basic Lands</div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-4">
                        @foreach (var (land, count) in Result.BasicLandCounts.OrderByDescending(kv => kv.Value))
                        {
                            <div>
                                <span class="fw-semibold">@count&times;</span>
                                <span class="text-muted small ms-1">@land</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

    @if (_view == DeckView.UpgradePaths)
    {
        @if (_isLoadingUpgrades)
        {
            <div class="card mx-3 mb-3">
                <div class="card-body text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    <span class="text-muted">@(_upgradeCurrentStage ?? "Loading upgrade suggestions…")</span>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelUpgrades">Cancel</button>
                </div>
            </div>
        }
        else if (_upgradeError is not null)
        {
            <div class="alert alert-danger mx-3 mb-3">
                <strong>Upgrade suggestions failed:</strong> @_upgradeError
            </div>
            <div class="card mx-3 mb-3">
                <div class="card-body">
                    <label class="form-label small fw-semibold mb-1">Max price per card (USD)</label>
                    <div class="d-flex gap-2 align-items-center">
                        <div class="input-group" style="max-width: 180px;">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" min="0" step="0.5"
                                   placeholder="no limit"
                                   @bind="_maxUpgradePriceUsd" @bind:event="oninput" />
                        </div>
                        <button class="btn btn-outline-primary btn-sm"
                                disabled="@(!CanGetUpgrades)"
                                @onclick="GetUpgradesAsync">Retry</button>
                    </div>
                </div>
            </div>
        }
        else if (!_upgradeStarted)
        {
            <div class="card mx-3 mb-3">
                <div class="card-header fw-semibold">Get Upgrade Suggestions</div>
                <div class="card-body">
                    <label class="form-label small fw-semibold mb-1">What isn't working? (optional)</label>
                    <textarea class="form-control mb-3" rows="2"
                              @bind="_userFeedback"
                              placeholder="e.g. I always struggle to recover from a board wipe, and I can never close out games."></textarea>
                    <label class="form-label small fw-semibold mb-1">Max price per card (USD)</label>
                    <div class="d-flex gap-2 align-items-center">
                        <div class="input-group" style="max-width: 180px;">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" min="0" step="0.5"
                                   placeholder="no limit"
                                   @bind="_maxUpgradePriceUsd" @bind:event="oninput" />
                        </div>
                        <button class="btn btn-primary"
                                disabled="@(!CanGetUpgrades)"
                                @onclick="GetUpgradesAsync">
                            Get Upgrade Suggestions
                        </button>
                    </div>
                    <div class="text-muted small mt-2">
                        Suggestions are drawn from the EDHREC pool for your commander and prioritize your biggest coverage gaps. Leave the budget empty to consider all cards regardless of price.
                    </div>
                </div>
            </div>
        }
        else if (_upgradeResult is not null && _upgradeResult.RoleUpgrades.Count == 0)
        {
            <div class="alert alert-info mx-3 mb-3">
                No upgrade suggestions found — your deck has no significant coverage gaps, or no EDHREC candidates were available within the current budget.
            </div>
            <div class="card mx-3 mb-3">
                <div class="card-body">
                    <label class="form-label small fw-semibold mb-1">Try a different budget cap</label>
                    <div class="d-flex gap-2 align-items-center">
                        <div class="input-group" style="max-width: 180px;">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" min="0" step="0.5"
                                   placeholder="no limit"
                                   @bind="_maxUpgradePriceUsd" @bind:event="oninput" />
                        </div>
                        <button class="btn btn-outline-primary btn-sm"
                                disabled="@(!CanGetUpgrades)"
                                @onclick="GetUpgradesAsync">Try Again</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="mb-3 mx-3 d-flex justify-content-end">
                <button class="btn btn-outline-secondary btn-sm" @onclick="GetUpgradesAsync">Refresh</button>
            </div>
            @foreach (var roleUpgrade in _upgradeResult!.RoleUpgrades)
            {
                <div class="card mb-4 mx-3">
                    <div class="card-header fw-semibold d-flex align-items-center gap-2">
                        <span class="me-auto">
                            @CardRoleDisplay.RoleName(roleUpgrade.Gap.Role)
                            <span class="text-muted fw-normal small ms-2">
                                actual @roleUpgrade.Gap.ActualCoverage.ToString("0.#") / ideal @roleUpgrade.Gap.IdealTarget
                            </span>
                        </span>
                        <span class="badge bg-warning text-dark">@roleUpgrade.Gap.Shortfall.ToString("0.#") short</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @for (int i = 0; i < roleUpgrade.Suggestions.Count; i++)
                        {
                            var s    = roleUpgrade.Suggestions[i];
                            var rank = i + 1;
                            <div class="list-group-item py-3">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="badge bg-secondary" style="font-size: 0.7rem;">Option @rank</span>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="badge bg-success">+ Add</span>
                                    <span class="fw-semibold">@s.AddCard.Name</span>
                                    @if (s.AddCard.ManaValue > 0)
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;" title="Mana value">
                                            @s.AddCard.ManaValue.ToString("0.#")
                                        </span>
                                    }
                                    @if (s.AddCard.PriceUsd.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;" title="Price">
                                            $@s.AddCard.PriceUsd.Value.ToString("F2")
                                        </span>
                                    }
                                    <span class="text-muted small">@s.AddCard.TypeLine</span>
                                </div>
                                <p class="text-muted small mb-2 ms-1">@s.AddRationale</p>
                                @if (s.CutCard is not null)
                                {
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <span class="badge bg-danger">− Cut</span>
                                        <span class="fw-semibold">@s.CutCard.Name</span>
                                        @if (s.CutCard.ManaValue > 0)
                                        {
                                            <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">
                                                @s.CutCard.ManaValue.ToString("0.#")
                                            </span>
                                        }
                                        @if (s.CutCard.PriceUsd.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">
                                                $@s.CutCard.PriceUsd.Value.ToString("F2")
                                            </span>
                                        }
                                        <span class="text-muted small">@s.CutCard.TypeLine</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(s.CutRationale))
                                    {
                                        <p class="text-muted small mb-0 ms-1">@s.CutRationale</p>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }

    @if (_view == DeckView.Combos)
    {
        @if (_isLoadingCombos)
        {
            <div class="card mx-3 mb-3">
                <div class="card-body text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    <span class="text-muted">Searching Commander Spellbook…</span>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelCombos">Cancel</button>
                </div>
            </div>
        }
        else if (_comboError is not null)
        {
            <div class="alert alert-danger mx-3 mb-3">
                <strong>Combo search failed:</strong> @_comboError
            </div>
            <div class="card mx-3 mb-3">
                <div class="card-body">
                    <button class="btn btn-outline-primary btn-sm" @onclick="FindCombosAsync">Retry</button>
                </div>
            </div>
        }
        else if (!_comboStarted)
        {
            <div class="card mx-3 mb-3">
                <div class="card-header fw-semibold">Find Combos</div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Searches <a href="https://commanderspellbook.com" target="_blank" rel="noopener noreferrer">Commander Spellbook</a>
                        for combos fully present in your built deck and near-misses (one card away).
                        Also returns a combo-aware bracket estimate.
                    </p>
                    <button class="btn btn-primary" @onclick="FindCombosAsync">Find Combos</button>
                </div>
            </div>
        }
        else if (_comboResult is not null)
        {
            @if (_comboResult.SpellbookBracketTag is not null)
            {
                <div class="alert alert-info mx-3 mb-3 py-2 d-flex align-items-center gap-2 flex-wrap">
                    <strong>Combo-aware bracket (Commander Spellbook):</strong>
                    <span class="badge @BracketTagCss(_comboResult.SpellbookBracketTag)">
                        @BracketTagLabel(_comboResult.SpellbookBracketTag)
                    </span>
                    <span class="text-muted small ms-auto">Based on combo presence, tutors, and game-changer cards.</span>
                </div>
            }

            <div class="mb-3 mx-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Powered by <a href="https://commanderspellbook.com" target="_blank" rel="noopener noreferrer">Commander Spellbook</a>
                    (MIT license)
                </span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="FindCombosAsync">Refresh</button>
            </div>

            @if (_comboResult.Combos.Included.Count == 0 && _comboResult.Combos.AlmostIncluded.Count == 0)
            {
                <div class="alert alert-secondary mx-3 mb-3">
                    No combos or near-misses found for this decklist.
                </div>
            }
            else
            {
                @if (_comboResult.Combos.Included.Count > 0)
                {
                    <div class="card mb-4 mx-3">
                        <div class="card-header fw-semibold">
                            Combos in your deck
                            <span class="badge bg-success ms-1 fw-normal">@_comboResult.Combos.Included.Count</span>
                        </div>
                        <div class="list-group list-group-flush">
                            @foreach (var combo in _comboResult.Combos.Included.OrderByDescending(c => c.Popularity))
                            {
                                var isExpanded = _expandedCombos.Contains(combo.Id);
                                var comboId    = combo.Id;
                                <div class="list-group-item py-3">
                                    <div class="d-flex flex-wrap align-items-start gap-2 mb-1"
                                         style="cursor:pointer;" @onclick="() => ToggleCombo(comboId)">
                                        <span class="badge bg-success">Complete</span>
                                        <span class="fw-semibold me-auto">@string.Join(", ", combo.ProducedEffects.Take(3))</span>
                                        @if (!string.IsNullOrEmpty(combo.BracketTag))
                                        {
                                            <span class="badge @BracketTagCss(combo.BracketTag)" style="font-size:0.7rem;"
                                                  title="@BracketTagLabel(combo.BracketTag)">@combo.BracketTag</span>
                                        }
                                        <span class="text-muted small">@(isExpanded ? "▼" : "▶")</span>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                        <span class="text-muted small" style="min-width:6rem;">In your deck:</span>
                                        @foreach (var piece in combo.OwnedPieces)
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-dark border border-success"
                                                  style="font-size:0.75rem;">&#10003; @piece.Name</span>
                                        }
                                    </div>
                                    @if (isExpanded)
                                    {
                                        @if (!string.IsNullOrEmpty(combo.ManaNeeded))
                                        {
                                            <div class="text-muted small mb-1"><strong>Mana:</strong> @combo.ManaNeeded</div>
                                        }
                                        @if (!string.IsNullOrEmpty(combo.NotablePrerequisites))
                                        {
                                            <div class="text-muted small mb-2"><strong>Prerequisites:</strong> @combo.NotablePrerequisites</div>
                                        }
                                        @if (!string.IsNullOrEmpty(combo.Description))
                                        {
                                            <ol class="small text-muted mb-0 ps-3">
                                                @foreach (var step in combo.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    <li class="mb-1">@step</li>
                                                }
                                            </ol>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_comboResult.Combos.AlmostIncluded.Count > 0)
                {
                    <div class="card mb-4 mx-3">
                        <div class="card-header fw-semibold">
                            Near-miss combos &mdash; 1 card away
                            <span class="badge bg-warning text-dark ms-1 fw-normal">@_comboResult.Combos.AlmostIncluded.Count</span>
                        </div>
                        <div class="list-group list-group-flush">
                            @foreach (var combo in _comboResult.Combos.AlmostIncluded.OrderByDescending(c => c.Popularity))
                            {
                                var isExpanded = _expandedCombos.Contains(combo.Id);
                                var comboId    = combo.Id;
                                <div class="list-group-item py-3">
                                    <div class="d-flex flex-wrap align-items-start gap-2 mb-1"
                                         style="cursor:pointer;" @onclick="() => ToggleCombo(comboId)">
                                        <span class="fw-semibold me-auto">@string.Join(", ", combo.ProducedEffects.Take(3))</span>
                                        @if (!string.IsNullOrEmpty(combo.BracketTag))
                                        {
                                            <span class="badge @BracketTagCss(combo.BracketTag)" style="font-size:0.7rem;"
                                                  title="@BracketTagLabel(combo.BracketTag)">@combo.BracketTag</span>
                                        }
                                        <span class="text-muted small">@(isExpanded ? "▼" : "▶")</span>
                                    </div>
                                    <div class="mb-1">
                                        @if (combo.OwnedPieces.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                                <span class="text-muted small" style="min-width:6rem;">In your deck:</span>
                                                @foreach (var piece in combo.OwnedPieces)
                                                {
                                                    <span class="badge bg-success bg-opacity-25 text-dark border border-success"
                                                          style="font-size:0.75rem;">&#10003; @piece.Name</span>
                                                }
                                            </div>
                                        }
                                        @foreach (var missing in combo.MissingCardNames)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                                <span class="text-muted small" style="min-width:6rem;">Missing:</span>
                                                <span class="badge bg-danger bg-opacity-25 text-dark border border-danger"
                                                      style="font-size:0.75rem;">@missing</span>
                                            </div>
                                        }
                                        @foreach (var tmpl in combo.MissingTemplates)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                                <span class="text-muted small" style="min-width:6rem;">Needs any:</span>
                                                <span class="badge bg-secondary bg-opacity-25 text-dark border"
                                                      style="font-size:0.75rem;">@tmpl</span>
                                            </div>
                                        }
                                    </div>
                                    @if (isExpanded)
                                    {
                                        @if (!string.IsNullOrEmpty(combo.ManaNeeded))
                                        {
                                            <div class="text-muted small mb-1"><strong>Mana:</strong> @combo.ManaNeeded</div>
                                        }
                                        @if (!string.IsNullOrEmpty(combo.NotablePrerequisites))
                                        {
                                            <div class="text-muted small mb-2"><strong>Prerequisites:</strong> @combo.NotablePrerequisites</div>
                                        }
                                        @if (!string.IsNullOrEmpty(combo.Description))
                                        {
                                            <ol class="small text-muted mb-0 ps-3">
                                                @foreach (var step in combo.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    <li class="mb-1">@step</li>
                                                }
                                            </ol>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
    }

</div>
