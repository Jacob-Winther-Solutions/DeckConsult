<div class="py-4" style="max-width: 1000px; margin: 0 auto;">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <div class="d-flex flex-wrap align-items-start gap-3 px-3 mb-4">
        <div class="flex-grow-1">
            <h3 class="mb-0">@string.Join(" + ", Commanders.Select(c => c.Name))</h3>
            <div class="text-muted small">@string.Join(" / ", Commanders.Select(c => c.TypeLine))</div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ColorIdentityPips Identity="CommanderColorIdentity" />
            <span class="badge bg-secondary">
                Bracket @((int)Bracket) &mdash; @BracketLibrary.All[Bracket].Name
            </span>
            <span class="badge bg-light text-dark border">
                @(Result.Deck.Count + Result.BasicLandCounts.Values.Sum()) / @(100 - Commanders.Count) cards
            </span>
            @if (Result.TotalPriceUsd > 0)
            {
                var nonLockedTotal = Result.Deck.Where(s => !s.IsLocked).Sum(s => s.Card.PriceUsd ?? 0m);
                var overTotal = TotalBudgetUsd.HasValue && nonLockedTotal > TotalBudgetUsd;
                var lockedCount = Result.Deck.Count(s => s.IsLocked);
                var priceTitle = TotalBudgetUsd.HasValue
                    ? (lockedCount > 0 ? $"Budget: ${TotalBudgetUsd:F2} (excl. {lockedCount} locked card(s))" : $"Budget: ${TotalBudgetUsd:F2}")
                    : (lockedCount > 0 ? $"Excl. {lockedCount} locked card(s)" : "Total non-basic card price");
                <span class="badge @(overTotal ? "bg-danger" : "bg-light text-dark border")"
                      title="@priceTitle">
                    $@nonLockedTotal.ToString("F2")
                </span>
                @if (lockedCount > 0)
                {
                    <span class="badge bg-light text-muted border"
                          style="font-size: 0.7rem;"
                          title="Full deck total including locked cards">
                        $@Result.TotalPriceUsd.ToString("F2") incl. locked
                    </span>
                }
            }
        </div>
    </div>

    <!-- ── View tabs ──────────────────────────────────────────────────────── -->
    <ul class="nav nav-tabs px-3 mb-3">
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.ByRole ? "active" : "")"
                    @onclick="() => _view = DeckView.ByRole">Coverage Report</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.AllCards ? "active" : "")"
                    @onclick="() => _view = DeckView.AllCards">All Cards</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.ByType ? "active" : "")"
                    @onclick="() => _view = DeckView.ByType">By Type</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.ByManaValue ? "active" : "")"
                    @onclick="() => _view = DeckView.ByManaValue">By Mana Value</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.UpgradePaths ? "active" : "")"
                    @onclick="() => _view = DeckView.UpgradePaths">
                Upgrade Paths
                @if (_upgradeResult is not null)
                {
                    <span class="badge bg-success ms-1" style="font-size:0.65rem;">@_upgradeResult.RoleUpgrades.Sum(r => r.Suggestions.Count)</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_view == DeckView.Combos ? "active" : "")"
                    @onclick="() => _view = DeckView.Combos">
                Combos
                @if (_comboResult is not null)
                {
                    var total = _comboResult.Combos.Included.Count + _comboResult.Combos.AlmostIncluded.Count;
                    <span class="badge bg-success ms-1" style="font-size:0.65rem;">@total</span>
                }
            </button>
        </li>
    </ul>

    @if (_view == DeckView.ByRole)
    {
        <CoverageReportPanel Cards="AnalysisResult.Cards"
                             ActualCoverage="Result.ActualCoverage"
                             BasicLandCounts="Result.BasicLandCounts"
                             Targets="Result.PlannedTemplate.Targets"
                             ExtraLandCoverage="Result.BasicLandCounts.Values.Sum()"
                             MaxCardPriceUsd="MaxCardPriceUsd"
                             CardRanks="CardRankLookup"
                             CutOracleIds="CutOracleIdsByRole"
                             RunnerUps="Result.RunnerUps">
            <Alerts>
                @if (Result.CoverageWarnings.Count > 0)
                {
                    <div class="alert alert-warning mx-3 mb-3">
                        <strong>Coverage warnings</strong>
                        <ul class="mb-0 mt-1 small">
                            @foreach (var warning in Result.CoverageWarnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </div>
                }
                @if (Result.BudgetWarnings.Count > 0)
                {
                    <div class="alert alert-danger mx-3 mb-3">
                        <strong>Budget warnings</strong>
                        <ul class="mb-0 mt-1 small">
                            @foreach (var warning in Result.BudgetWarnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </div>
                }
            </Alerts>
        </CoverageReportPanel>
    }

    @if (_view == DeckView.ByType)
    {
        <CardsByTypeList Cards="AnalysisResult.CommanderCards.Concat(AnalysisResult.Cards).ToList()"
                         BasicLandCounts="Result.BasicLandCounts"
                         MaxCardPriceUsd="MaxCardPriceUsd" />
    }

    @if (_view == DeckView.AllCards)
    {
        <!-- ── All cards table ────────────────────────────────────────────── -->
        <div class="card mx-3 mb-3">
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead class="text-muted" style="font-size: 0.8rem;">
                        <tr>
                            <th class="ps-3 fw-normal">Card</th>
                            <th class="fw-normal text-center" style="width: 48px;">MV</th>
                            <th class="fw-normal text-center" style="width: 64px;">Price</th>
                            <th class="fw-normal">Type</th>
                            <th class="fw-normal">Roles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var suggestion in Result.Deck.OrderBy(s => s.Card.Name))
                        {
                            var isOverAll = !suggestion.IsLocked && IsOverBudget(suggestion.Card);
                            <tr class="@(isOverAll ? "table-danger" : "")">
                                <td class="ps-3 fw-semibold">
                                    @suggestion.Card.Name
                                    @if (suggestion.IsLocked)
                                    {
                                        <span class="badge bg-secondary ms-1" style="font-size:0.65rem;" title="Locked by user — will not be cut">&#128274; locked</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (suggestion.Card.ManaValue > 0)
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">
                                            @suggestion.Card.ManaValue.ToString("0.#")
                                        </span>
                                    }
                                </td>
                                <td class="text-center small @(isOverAll ? "fw-semibold" : "text-muted")">
                                    @FormatPrice(suggestion.Card.PriceUsd)
                                </td>
                                <td class="text-muted small">@suggestion.Card.TypeLine</td>
                                <td>
                                    <span class="badge @PrimaryRoleBadgeClass(suggestion.Roles.Primary)"
                                          style="font-size: 0.7rem;">
                                        @RoleName(suggestion.Roles.Primary)
                                    </span>
                                    @foreach (var contrib in suggestion.Roles.Secondary)
                                    {
                                        var b = SecondaryBadge(contrib);
                                        <span class="badge @b.CssClass ms-1"
                                              style="font-size: 0.7rem;"
                                              title="@b.Tooltip">@b.Label</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ── Basic lands ────────────────────────────────────────────────── -->
        @if (Result.BasicLandCounts.Count > 0)
        {
            <div class="card mx-3 mb-3">
                <div class="card-header small fw-semibold text-muted">Basic Lands</div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-4">
                        @foreach (var (land, count) in Result.BasicLandCounts.OrderByDescending(kv => kv.Value))
                        {
                            <div>
                                <span class="fw-semibold">@count&times;</span>
                                <span class="text-muted small ms-1">@land</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

    @if (_view == DeckView.ByManaValue)
    {
        <ManaCurveChart AnalysisResult="AnalysisResult" />
    }

    @if (_view == DeckView.UpgradePaths)
    {
        <UpgradePathsPanel @ref="_upgradePanel"
                           AnalysisResult="AnalysisResult"
                           Upgrader="Upgrader"
                           Keys="Keys"
                           ApiKeyState="ApiKeyState"
                           OnRunStarted="() => _view = DeckView.UpgradePaths"
                           OnResultChanged="r => _upgradeResult = r" />
    }

    @if (_view == DeckView.Combos)
    {
        <CombosPanel @ref="_comboPanel"
                     AnalysisResult="AnalysisResult"
                     ComboFinder="ComboFinder"
                     OnRunStarted="() => _view = DeckView.Combos"
                     OnResultChanged="r => _comboResult = r" />
    }

</div>
