<div class="d-flex align-items-center gap-2 px-3 pt-4 pb-2">
    <button class="btn btn-outline-secondary btn-sm" @onclick="OnReset">&#8592; Build another</button>
    <button class="btn @(_copiedDecklist ? "btn-success" : "btn-outline-primary") btn-sm"
            @onclick="CopyDecklistAsync">
        @(_copiedDecklist ? "Copied!" : "Copy Decklist")
    </button>
    <button class="btn btn-outline-primary btn-sm" @onclick="DownloadDecklistAsync">
        Download (.txt)
    </button>
    <button class="btn btn-outline-primary btn-sm" @onclick="OnDownloadReport">
        Export Build Report
    </button>
</div>
