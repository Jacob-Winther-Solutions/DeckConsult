@if (SelectedCommanders.Count < 2)
{
    <div class="position-relative mb-2">
        <input class="form-control"
               type="text"
               placeholder="Search for a commander…"
               value="@_commanderQuery"
               @oninput="OnCommanderInput"
               @onfocus="OnSearchFocus"
               @onblur="OnSearchBlur"
               autocomplete="off" />
        @if (_isSearching)
        {
            <div class="position-absolute top-50 end-0 translate-middle-y pe-3">
                <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
            </div>
        }
        @if (_showDropdown && _searchResults.Count > 0)
        {
            <div class="list-group position-absolute w-100 shadow-sm" style="z-index: 1050; top: 100%; left: 0;">
                @foreach (var card in _searchResults)
                {
                    <button type="button"
                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                            @onclick="() => SelectCommander(card)">
                        <span>@card.Name</span>
                        <span class="d-flex gap-1">
                            <ColorIdentityPips Identity="card.ColorIdentity" />
                        </span>
                    </button>
                }
            </div>
        }
    </div>
}

@if (SelectedCommanders.Count > 0)
{
    <div class="d-flex flex-wrap gap-2 mt-2">
        @foreach (var commander in SelectedCommanders)
        {
            <div class="d-flex align-items-center gap-2 border rounded px-3 py-2 bg-light">
                <div>
                    <div class="fw-semibold small">@commander.Name</div>
                    <div class="text-muted" style="font-size: 0.75rem;">@commander.TypeLine</div>
                </div>
                <div class="d-flex gap-1">
                    <ColorIdentityPips Identity="commander.ColorIdentity" />
                </div>
                <button type="button" class="btn-close btn-sm ms-1" aria-label="Remove"
                        @onclick="() => RemoveCommander(commander)"></button>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted small mb-0 mt-1">Select up to two commanders for a partner pair.</p>
}
