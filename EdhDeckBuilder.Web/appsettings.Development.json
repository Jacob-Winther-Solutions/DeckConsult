{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Http.DefaultHttpClientFactory": "Warning"
    }
  },
  "Features": {
    "EnableTokenUsageTracking": true
  },
  "Provider": {
    "Default": "Google" // Options: "Google", "Anthropic", "GitHubModels"
  },
  "Instrumentation": {
    "LogClassificationResponses": true,
    "LogRawLlmRequests": true,
    "EnableStructuredDeckBuildLogging": true,
    "EnableClassificationReasoning": true
  }
}
